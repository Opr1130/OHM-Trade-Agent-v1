# Tradevisor V2 webhook edge — EXAMPLE ONLY.
#
# This file documents the reviewed boundary. It is NOT deployed by anything in
# this repository and it contains no secret values: replace every <PLACEHOLDER>.
#
# DEPLOYMENT MODE: this example is the DNS-ONLY machine-to-machine mode. It
# assumes TradingView connects directly to this edge, so `$remote_addr` is the
# real TradingView source address. Do NOT put Cloudflare's proxy in front of
# this vhost: with the orange cloud enabled every request arrives from a
# Cloudflare address, the four `allow` lines reject all real traffic, and
# `X-Forwarded-For $remote_addr` would overwrite the true client identity.
# See TRADEVISOR_V2.md "Two edge deployment modes" for the proxied variant,
# which requires a differently reviewed configuration.
#
# TradingView documents these source addresses for webhooks:
#   52.89.214.238  34.212.75.30  54.218.53.128  52.32.178.7
# Ports 80/443 only, IPv6 unsupported, and the whole request must be answered
# within 3 seconds — so the proxy must not add its own latency.
#
# The app additionally checks that the immediate peer is in
# OPIP_TRADEVISOR_TRUSTED_PROXY_IPS and that this header carries
# OPIP_TRADEVISOR_INTERNAL_VERIFICATION_VALUE.
#
# TLS AND MULTIPLE VIRTUAL HOSTS
# ------------------------------
# nginx chooses the TLS policy of the *SNI host* the client asked for. A client
# that sends no SNI, or an unknown one, is served by the default server for that
# listen socket. If this vhost were not the default server, such a handshake
# would negotiate against whatever sibling vhost happens to own the default -
# possibly with an older protocol floor - and the webhook would appear reachable
# on a weaker policy even though this file is correct.
#
# This edge is therefore DEDICATED: one host, one webhook vhost, declared
# `default_server` on :443. That has two consequences the operator must accept:
#   1. every no-SNI handshake is judged by the policy below (TLS 1.2 minimum);
#   2. adding a second `default_server` for :443 - or dropping this file onto a
#      host that already has one - makes `nginx -t` fail with "duplicate default
#      server", so a conflicting configuration is refused at validation time
#      instead of silently downgrading this endpoint.

limit_req_zone $binary_remote_addr zone=tradevisor_webhook:1m rate=30r/m;

server {
    listen 443 ssl default_server;
    server_name <WEBHOOK_HOST>;

    # Do not advertise the edge's own version to an unauthenticated caller.
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Server scope so every location inherits the same throttle status: the
    # application answers 429 for its own limiter, and nginx's default 503
    # would make a throttled alert indistinguishable from an outage.
    limit_req_status 429;

    ssl_certificate     /etc/letsencrypt/live/<WEBHOOK_HOST>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<WEBHOOK_HOST>/privkey.pem;

    # Tradevisor route only. Everything else on this host is refused.
    location = /webhooks/tradevisor/v1 {
        allow 52.89.214.238;
        allow 34.212.75.30;
        allow 54.218.53.128;
        allow 52.32.178.7;
        deny all;

        limit_except POST {
            deny all;
        }
        limit_req zone=tradevisor_webhook burst=20 nodelay;

        client_max_body_size 8k;

        proxy_pass http://127.0.0.1:8000/webhooks/tradevisor/v1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;

        # Proves the request crossed this proxy. Generate a unique value and
        # keep it equal to OPIP_TRADEVISOR_INTERNAL_VERIFICATION_VALUE.
        proxy_set_header x-ohm-tradevisor-verification "<EDGE_VERIFICATION_VALUE>";

        proxy_connect_timeout 1s;
        proxy_send_timeout 2s;
        proxy_read_timeout 2s;
    }

    # The Wave 8.2 bridge must NOT be reachable from this vhost.
    location / {
        return 404;
    }
}
