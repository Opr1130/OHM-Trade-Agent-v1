#!/usr/bin/env bash
# O'Pip isolated scan dispatcher (R01/R02/R06).
#
# NOT a scheduler. It is invoked once per existing cron tick, owns no cadence,
# keeps no queue and performs no retry loop. It acts only on a single-use token
# that the core has already authorised, so the cadence authority stays exactly
# where it was: operator_control.search_due inside the unified cycle.
#
# The dispatch is detached. The cron invocation therefore returns immediately
# and never holds the unified-cycle lock for the duration of a scan, which is
# what keeps active-position protection timely during a slow, hung or
# OOM-killed acquisition.
set -Eeuo pipefail

REPO_DIR="${OPIP_REPO_DIR:-/opt/OHM-Trade-Agent-v1/OHM-Trade-Agent-v1}"
STATE_DIR="${REPO_DIR}/data/scan"
STAGING_DIR="${STATE_DIR}/staging"
TOKEN="${STATE_DIR}/admission_token.json"
EVIDENCE="${STATE_DIR}/container_evidence.json"
SCAN_LOCK="${OPIP_SCAN_LOCK:-/var/run/ohm-scan.lock}"
SERVICE="${OPIP_SCAN_SERVICE:-opip-scan-worker}"
LABEL="opip.attempt_id"
LOG_DIR="${OPIP_SCAN_LOG_DIR:-/var/log}"

cd "$REPO_DIR"
mkdir -p "$STAGING_DIR"

log() { printf '%s opip-scan-dispatch %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

# --- 1. Capture postmortem evidence for exited attempts, then remove them ---
while IFS= read -r cid; do
  [ -n "$cid" ] || continue
  attempt="$(docker inspect -f "{{ index .Config.Labels \"${LABEL}\" }}" "$cid" 2>/dev/null || true)"
  [ -n "$attempt" ] || continue
  [ "$attempt" != "<no value>" ] || continue
  # Attempt ids carry a 'SCAN:' prefix; the colon is not path-safe everywhere,
  # so the directory name is normalised exactly as the Python sanitiser does.
  safe_attempt="$(printf '%s' "$attempt" | tr -c 'A-Za-z0-9_.-' '-')"
  out="${STAGING_DIR}/${safe_attempt}"
  mkdir -p "$out"
  tmp="${out}/container_exit.json.tmp"
  {
    printf '{"schema_version":1,"container_id":"%s",' "$cid"
    printf '"captured_at":"%s",' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    docker inspect -f '"attempt_id":"{{ index .Config.Labels \"'"${LABEL}"'\" }}","state":{{ json .State }},"host_config_limits":{"memory":{{ .HostConfig.Memory }},"nano_cpus":{{ .HostConfig.NanoCpus }},"pids_limit":{{ .HostConfig.PidsLimit }}}}' "$cid"
  } > "$tmp" 2>/dev/null || { log "evidence capture failed for ${cid}"; rm -f "$tmp"; continue; }
  mv -f "$tmp" "${out}/container_exit.json"
  docker rm -f "$cid" >/dev/null 2>&1 || true
  log "captured and removed exited container ${cid} for ${attempt}"
done < <(docker ps -aq --filter "label=${LABEL}" --filter "status=exited" 2>/dev/null || true)

# --- 2. Publish observed liveness for the core's reconciliation -------------
running_ids=()
while IFS= read -r cid; do
  [ -n "$cid" ] || continue
  attempt="$(docker inspect -f "{{ index .Config.Labels \"${LABEL}\" }}" "$cid" 2>/dev/null || true)"
  [ -n "$attempt" ] && [ "$attempt" != "<no value>" ] && running_ids+=("$attempt")
done < <(docker ps -q --filter "label=${LABEL}" 2>/dev/null || true)

if [ "${#running_ids[@]}" -eq 0 ]; then
  alive='[]'
else
  alive="$(printf '"%s",' "${running_ids[@]}")"
  alive="[${alive%,}]"
fi
printf '{"schema_version":1,"observed_at":"%s","source":"dispatcher","alive_attempt_ids":%s}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$alive" > "${EVIDENCE}.tmp"
mv -f "${EVIDENCE}.tmp" "$EVIDENCE"

# --- 3. Act only on an authorised, unexpired token -------------------------
[ -s "$TOKEN" ] || exit 0

attempt_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("attempt_id",""))' "$TOKEN" 2>/dev/null || true)"
expires_at="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("expires_at",""))' "$TOKEN" 2>/dev/null || true)"
[ -n "$attempt_id" ] || { log "token unreadable; ignoring"; exit 0; }

if [ -n "$expires_at" ]; then
  if ! python3 -c 'import sys,datetime as d; e=d.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")); sys.exit(0 if d.datetime.now(d.timezone.utc) < e else 1)' "$expires_at" 2>/dev/null; then
    log "token for ${attempt_id} expired; not dispatching"
    exit 0
  fi
fi

# Never start a second container for the same attempt.
for existing in "${running_ids[@]:-}"; do
  if [ "${existing}" = "${attempt_id}" ]; then
    log "attempt ${attempt_id} already running; refusing overlap"
    exit 0
  fi
done

# --- 4. Launch detached under a scan-scoped lock ---------------------------
exec 9>"$SCAN_LOCK"
if ! flock -n 9; then
  log "another scan holds ${SCAN_LOCK}; refusing overlap"
  exit 0
fi

# No --rm: the container must survive long enough for step 1 to capture its
# exit state and OOM flag on a later tick.
nohup setsid docker compose run \
  --name "opip-scan-$(printf '%s' "$attempt_id" | tr -c 'A-Za-z0-9_.-' '-')" \
  --label "${LABEL}=${attempt_id}" \
  --no-deps \
  "$SERVICE" python -m app.jobs.scan_worker --attempt-id "$attempt_id" \
  >> "${LOG_DIR}/ohm-scan-worker-${attempt_id//[^A-Za-z0-9_.-]/-}.log" 2>&1 &

log "dispatched attempt ${attempt_id} (detached)"

# Single use: the token must not start a second worker on the next tick.
rm -f "$TOKEN"
