# O'Pip unified production cycle
# Single canonical scheduler for:
# active-trade protection -> pending lifecycle -> Early Watch -> paper learning
# -> broad opportunity scan when operator state/cadence allows.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * root flock -n /var/run/ohm-unified-cycle.lock -c 'cd /opt/OHM-Trade-Agent-v1/OHM-Trade-Agent-v1 && /usr/bin/docker compose exec -T ohm-trade-agent python -m app.jobs.run_cycle >> /var/log/ohm-unified-cycle.log 2>&1'
