# O'Pip Intelligence Committee — worker environment (TEMPLATE).
#
# Copy to /etc/opip/committee-credentials.env on the isolated Committee worker and
# populate the two credential values from the host's protected secret mechanism.
# The installed copy must be owned by root with mode 0600.
#
# NEVER commit a populated copy of this file. It is a template only: every value
# below is a placeholder, and none of them is a real credential.
#
# The Committee worker reads values from its process environment at start. It never
# writes a credential into source, an image layer, a log, a prompt, or Committee
# evidence.

# ---------------------------------------------------------------------------
# Provider credentials. Populate from the protected secret mechanism at install
# time. Do not paste these into chat, a ticket, or a commit.
# ---------------------------------------------------------------------------
OPIP_COMMITTEE_OPENAI_API_KEY=CHANGEME
OPIP_COMMITTEE_ANTHROPIC_API_KEY=CHANGEME

# ---------------------------------------------------------------------------
# Non-secret approved configuration. These are safe to keep in the file and match
# the values approved for the initial shadow bake-off.
# ---------------------------------------------------------------------------

# Dark by default. `off` performs no provider call and creates no case; only
# `shadow` permits committee work, and switching to it is a separate approval.
OPIP_COMMITTEE_MODE=off

# The exact release the worker runs. A branch name is refused: it cannot identify a
# released artifact. Set to the approved 40-character SHA at install time.
OPIP_COMMITTEE_RELEASE_SHA=CHANGEME

# Approved price book, in microunits per million tokens.
# OpenAI gpt-5.6-terra:   $2.00 in / $12.00 out
# Anthropic claude-sonnet-5: $2.00 in / $10.00 out
# Prompt-cache savings are NOT credited: cache usage and its cost effect are not
# measured yet, so cost is accounted at uncached rates.
OPIP_COMMITTEE_PRICES=openai:gpt-5.6-terra=2000000/12000000;anthropic:claude-sonnet-5=2000000/10000000

# Per-complete-candidate ceiling: $0.50. The UTC daily ceiling of $10 is enforced
# by the worker itself and needs no variable here.
OPIP_COMMITTEE_MAX_ESTIMATED_COST_MICROUNITS=500000

# Advisory output and evidence input locations. The evidence path is mounted
# read-only by the unit; only the advisory path is writable.
OPIP_COMMITTEE_HOME=/var/lib/opip-committee
OPIP_COMMITTEE_EVIDENCE_ROOT=/var/lib/opip-learning

# ---------------------------------------------------------------------------
# SHADOW activation inputs (IC-043). Leave these unset while the plane is OFF:
# the credentialled executor refuses to construct without them, so an
# accidentally flipped mode cannot become a paid run with no activation
# boundary. The activation workflow sets them from the command arguments.
# ---------------------------------------------------------------------------

# The explicit UTC activation boundary. A canonical decision context evaluated
# before this instant is never turned into a paid case, so historical Paper-v2
# contexts are not silently backfilled.
# OPIP_COMMITTEE_SHADOW_NOT_BEFORE=2026-09-24T00:00:00+00:00

# The registry review date. Every approved model route is refused after this
# instant, so "approved once" cannot silently mean "approved forever".
# OPIP_COMMITTEE_REGISTRY_REVIEW_BY=2026-12-24T00:00:00+00:00

# The learning export manifest that records the production release SHA the
# read-only canonical replica was produced from.
# OPIP_COMMITTEE_LEARNING_MANIFEST=/var/lib/opip-learning/manifest.env

# The host path of the verified read-only canonical replica generation root.
# OPIP_CANONICAL_REPLICA_ROOT_HOST=/var/lib/opip-learning/generations

# Initial canary capacity: one case per cycle. Raising it is a separate decision.
OPIP_COMMITTEE_MAX_CASES_PER_CYCLE=1

# ---------------------------------------------------------------------------
# NOT settable here: provider egress. Egress is a systemd address policy, not an
# environment value. `activate-committee-shadow.sh` pins the two approved
# provider endpoints as `IPAddressAllow=` entries in a unit drop-in while the
# unit keeps `IPAddressDeny=any`, so anything not listed stays denied.
# ---------------------------------------------------------------------------
