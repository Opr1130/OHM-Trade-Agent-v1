[Unit]
Description=O'Pip Intelligence Committee credentialled SHADOW canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/run-committee-credential-canary.sh

# The recurring worker remains OFF. This one-shot canary owns its own explicit
# in-process SHADOW gate and never changes the host's persistent Committee mode.
Environment=OPIP_COMMITTEE_MODE=off
EnvironmentFile=/run/opip/committee-credential-canary.env

TimeoutStartSec=180
TimeoutStopSec=15
KillMode=control-group
MemoryMax=512M
CPUQuota=100%
OOMScoreAdjust=700

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6

# Fail closed. The validation script creates a transient /run systemd drop-in
# containing only exact provider IPs resolved immediately before this one run.
IPAddressDeny=any

# The canary sees a private hosts file containing only localhost and the two
# approved provider hostnames pinned to the same IPs admitted by the drop-in.
BindReadOnlyPaths=/run/opip/committee-credential-canary-hosts:/etc/hosts

ReadWritePaths=/var/lib/opip-committee/credential-canary /var/lock
ReadOnlyPaths=/var/lib/opip-learning
