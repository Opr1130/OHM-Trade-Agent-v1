# Copy to /etc/opip-data-platform.env with owner root:root and mode 0600.
# Generate independent random passwords; never commit real values.
OPIP_DEPLOYED_SHA=0000000000000000000000000000000000000000
OPIP_POSTGRES_BIND_ADDRESS=127.0.0.1
OPIP_PRODUCTION_PRIVATE_CIDR=10.0.0.1/32
OPIP_OFFHOST_BACKUP_VERIFIED_AT_UTC=2026-09-01T00:00:00Z
OPIP_RESTORE_DRILL_VERIFIED_AT_UTC=2026-09-01T00:00:00Z
# Set only after completing the empty-stage rollback drill. Backfill refuses
# to run without this independently recorded evidence.
OPIP_EMPTY_ROLLBACK_VERIFIED_AT_UTC=2026-09-01T00:00:00Z
OPIP_POSTGRES_DB=opip
OPIP_POSTGRES_ADMIN_USER=opip_admin
OPIP_POSTGRES_ADMIN_PASSWORD=replace-with-32-plus-random-characters
OPIP_SHIPPER_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_LEARNING_DATABASE_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_DASHBOARD_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_ANALYTICS_ADMIN_DATABASE_URL=postgresql://opip_admin:replace@opip-postgres:5432/opip
OPIP_ANALYTICS_DATABASE_URL=postgresql://opip_shipper:replace@opip-postgres:5432/opip
