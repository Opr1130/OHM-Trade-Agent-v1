# Copy to /etc/opip-data-platform.env with owner root:root and mode 0600.
# Generate independent random passwords; never commit real values.
OPIP_DEPLOYED_SHA=0000000000000000000000000000000000000000
OPIP_POSTGRES_BIND_ADDRESS=127.0.0.1
OPIP_PRODUCTION_PRIVATE_CIDR=10.0.0.1/32
# Rollout evidence is recorded under /var/lib/opip-data-platform by the
# owner-gated backup/restore/offhost/rollback stages. Keep mutable evidence
# timestamps out of this sealed credential file.
# PostgreSQL TLS material is host-managed under /etc/opip-data-platform/tls:
#   postgres-ca.crt, postgres-server.crt, postgres-server.key
# The server certificate must chain to postgres-ca.crt and contain
# subjectAltName DNS:opip-postgres so Grafana verify-full can validate it.
OPIP_POSTGRES_DB=opip
OPIP_POSTGRES_ADMIN_USER=opip_admin
# These two passwords are interpolated directly into PostgreSQL URI DSNs below.
# Restrict them to URI-unreserved characters only: A-Z a-z 0-9 - . _ ~
# Bootstrap rejects reserved characters for these raw passwords. Add explicit
# percent-encoding to the DSN builder before relaxing this enforced policy.
OPIP_POSTGRES_ADMIN_PASSWORD=replace-with-32-plus-uri-unreserved-characters
OPIP_SHIPPER_PASSWORD=replace-with-independent-32-plus-uri-unreserved-characters
OPIP_LEARNING_DATABASE_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_DASHBOARD_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_GRAFANA_ADMIN_USER=opip_grafana_admin
OPIP_GRAFANA_ADMIN_PASSWORD=replace-with-independent-32-plus-random-characters
OPIP_GRAFANA_DB_USER=opip_dashboard
OPIP_GRAFANA_DB_PASSWORD=replace-with-opip-dashboard-password
OPIP_GRAFANA_DB_NAME=opip
OPIP_GRAFANA_DB_SSLMODE=verify-full
OPIP_GRAFANA_POSTGRES_HOST=opip-postgres
OPIP_GRAFANA_POSTGRES_PORT=5432
OPIP_GRAFANA_BIND_ADDRESS=127.0.0.1
OPIP_GRAFANA_HOST_PORT=3000
OPIP_GRAFANA_HTTP_PORT=3000
OPIP_GRAFANA_DOMAIN=analytics.example.com
OPIP_GRAFANA_ROOT_URL=https://analytics.example.com/grafana
OPIP_GRAFANA_SERVE_FROM_SUB_PATH=true
OPIP_ANALYTICS_ADMIN_DATABASE_URL=postgresql://opip_admin:${OPIP_POSTGRES_ADMIN_PASSWORD}@opip-postgres:5432/opip
OPIP_ANALYTICS_DATABASE_URL=postgresql://opip_shipper:${OPIP_SHIPPER_PASSWORD}@opip-postgres:5432/opip
