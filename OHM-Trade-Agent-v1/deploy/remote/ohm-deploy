#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_SHA="${1:-}"
REPO_ROOT="/opt/OHM-Trade-Agent-v1"
APP_ROOT="$REPO_ROOT/OHM-Trade-Agent-v1"
LOCK_FILE="/var/lock/ohm-deploy.lock"
STATE_DIR="/var/lib/ohm-deploy"
LAST_GOOD_FILE="$STATE_DIR/last-good-sha"
SCHEDULER_RECONCILE="$APP_ROOT/deploy/remote/reconcile-scheduler.sh"

if [[ ! "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "invalid target sha" >&2
  exit 64
fi

install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 75
fi

REPO_OWNER="$(stat -c '%U' "$REPO_ROOT/.git")"
GIT=(sudo -u "$REPO_OWNER" git -C "$REPO_ROOT")

"${GIT[@]}" fetch --prune origin main
REMOTE_MAIN_SHA="$("${GIT[@]}" rev-parse origin/main)"
if [[ "$TARGET_SHA" != "$REMOTE_MAIN_SHA" ]]; then
  echo "refusing deploy: target is not current origin/main" >&2
  echo "target=$TARGET_SHA origin/main=$REMOTE_MAIN_SHA" >&2
  exit 65
fi

if [[ -n "$("${GIT[@]}" status --porcelain --untracked-files=no)" ]]; then
  echo "refusing deploy: tracked production worktree is dirty" >&2
  "${GIT[@]}" status --short >&2
  exit 66
fi

PREVIOUS_SHA="$("${GIT[@]}" rev-parse main)"
if [[ -s "$LAST_GOOD_FILE" ]]; then
  RECORDED_SHA="$(cat "$LAST_GOOD_FILE")"
  if [[ "$RECORDED_SHA" =~ ^[0-9a-f]{40}$ ]] && "${GIT[@]}" cat-file -e "$RECORDED_SHA^{commit}" 2>/dev/null; then
    PREVIOUS_SHA="$RECORDED_SHA"
  fi
fi

rollback() {
  rc=$?
  trap - ERR
  echo "deployment failed; rolling back to $PREVIOUS_SHA" >&2
  "${GIT[@]}" checkout -f main
  "${GIT[@]}" reset --hard "$PREVIOUS_SHA"
  cd "$APP_ROOT"
  docker compose build ohm-trade-agent
  docker compose up -d --remove-orphans ohm-trade-agent
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error http://127.0.0.1:8000/health | grep -q '"status":"ok"'; then
      echo "rollback health check passed" >&2
      exit "$rc"
    fi
    sleep 2
  done
  echo "rollback health check failed" >&2
  exit "$rc"
}
trap rollback ERR

"${GIT[@]}" checkout -f main
"${GIT[@]}" reset --hard "$TARGET_SHA"

cd "$APP_ROOT"
docker compose build ohm-trade-agent
docker compose up -d --remove-orphans ohm-trade-agent

healthy=0
for _ in $(seq 1 30); do
  if curl --fail --silent --show-error http://127.0.0.1:8000/health | grep -q '"status":"ok"'; then
    healthy=1
    break
  fi
  sleep 2
done

if [[ "$healthy" != "1" ]]; then
  echo "production health check failed" >&2
  false
fi

if [[ ! -s "$SCHEDULER_RECONCILE" ]]; then
  echo "scheduler reconciliation script missing" >&2
  false
fi
bash "$SCHEDULER_RECONCILE"

# Evidence capture is intentionally non-authoritative. Probe it once so the
# deployment log records whether the production evidence boundary is enabled
# and whether the worker can read/write its local stores. A probe failure must
# never roll back otherwise healthy deterministic trading protection.
echo "O'Pip ML evidence capture smoke probe"
if flock -n /var/run/opip-ml-capture-trigger.lock -c \
  'cd /opt/OHM-Trade-Agent-v1/OHM-Trade-Agent-v1 && /usr/bin/docker compose exec -T ohm-trade-agent python -m app.jobs.run_opip_ml_capture'; then
  echo "O'Pip ML evidence capture smoke probe: completed"
else
  echo "O'Pip ML evidence capture smoke probe: skipped/degraded; capture lock busy or probe failed; production unaffected" >&2
fi

printf '%s\n' "$TARGET_SHA" > "$LAST_GOOD_FILE"
trap - ERR

echo "OHM deployment succeeded"
echo "sha=$TARGET_SHA"
docker compose ps
curl --fail --silent --show-error http://127.0.0.1:8000/health
echo
