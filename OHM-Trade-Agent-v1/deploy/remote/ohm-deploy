#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_SHA="${1:-}"
REPO_ROOT="/opt/OHM-Trade-Agent-v1"
APP_ROOT="$REPO_ROOT/OHM-Trade-Agent-v1"
DATA_ROOT="$APP_ROOT/data"
# Same interpreter convention as the rest of the production scripts.
PYTHON_BIN="${OPIP_PYTHON_BIN:-/usr/bin/python3}"
DEPLOY_SCRIPT_DST="/usr/local/sbin/ohm-deploy"
SSH_GATEWAY_DST="/usr/local/sbin/ohm-deploy-ssh"
LEARNING_READER_DST="/usr/local/sbin/opip-learning-read-export"
LEARNING_DIAGNOSTICS_DST="/usr/local/sbin/diagnose-opip-learning"
P1_RETIRE_SCRIPT="$APP_ROOT/deploy/remote/retire-p1-shadow-outbox.sh"
LEARNING_EXPORTER="$APP_ROOT/deploy/remote/export-opip-learning-evidence.sh"

if [[ "$TARGET_SHA" == "diagnose-learning" ]]; then
  [[ -x "$LEARNING_DIAGNOSTICS_DST" ]] || {
    echo "learning diagnostics helper is not installed" >&2
    exit 69
  }
  exec "$LEARNING_DIAGNOSTICS_DST"
fi
LOCK_FILE="/var/lock/ohm-deploy.lock"
STATE_DIR="/var/lib/ohm-deploy"
LAST_GOOD_FILE="$STATE_DIR/last-good-sha"
SAFE_BASELINE_OVERRIDE="$STATE_DIR/safe-baseline-rollback.override.yml"
# Durable paper-registry initialization provenance. Lives in host operational
# state so it outlives the registry it protects and never becomes evidence a
# reader could be handed. See app/services/paper_registry_genesis.py.
PAPER_GENESIS_MARKER="$STATE_DIR/paper-registry-initialized-v1"
SCHEDULER_RECONCILE="$APP_ROOT/deploy/remote/reconcile-scheduler.sh"
PAPER_COMPOSE="$APP_ROOT/docker-compose.paper.yml"
# Export root and proof bounds, mirroring the exporter and the verification
# helper. Kept explicit here so the deploy gate cannot drift from them.
EXPORT_ROOT="/var/lib/opip-learning-export"
EXPORT_PROOF_FRESHNESS_SECONDS=600
EXPORT_PROOF_WAIT_SECONDS=360
SCHEDULER_SNAPSHOT=""
# Set immediately BEFORE the runtime verifier runs, so the rollback handler can
# emit the capture producers' own durable disposition when the verifier is the
# failing command that triggered the rollback.
RELEASE_RUNTIME_VERIFIER_ATTEMPTED=""

if [[ ! "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "invalid target sha" >&2
  exit 64
fi

install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 75
fi

REPO_OWNER="$(stat -c '%U' "$REPO_ROOT/.git")"
GIT=(sudo -u "$REPO_OWNER" git -C "$REPO_ROOT")

wait_core_health() {
  local healthy=0
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error http://127.0.0.1:8000/health \
      | grep -q '"status":"ok"'; then
      healthy=1
      break
    fi
    sleep 2
  done
  [[ "$healthy" == "1" ]]
}

wait_writer_health() {
  # Writer health is validated separately from core. Core must never depend on
  # writer availability to start; this check only gates a successful deploy of
  # the PR 2 service itself.
  local cid status
  for _ in $(seq 1 30); do
    cid="$(docker compose ps -q opip-canonical-writer 2>/dev/null || true)"
    if [[ -n "$cid" ]]; then
      status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
      if [[ "$status" == "healthy" ]]; then
        return 0
      fi
    fi
    sleep 2
  done
  echo "opip-canonical-writer health check failed" >&2
  docker compose ps opip-canonical-writer >&2 || true
  return 1
}

validate_writer_resource_limits() {
  local actual expected_mem expected_swap expected_nano expected_pids
  expected_mem=134217728
  expected_swap=134217728
  expected_nano=150000000
  expected_pids=64
  actual="$(docker inspect --format='{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}|{{.HostConfig.NanoCpus}}|{{.HostConfig.PidsLimit}}' opip-canonical-writer 2>/dev/null || true)"
  if [[ "$actual" != "${expected_mem}|${expected_swap}|${expected_nano}|${expected_pids}" ]]; then
    echo "writer resource limit mismatch: expected=${expected_mem}|${expected_swap}|${expected_nano}|${expected_pids} actual=$actual" >&2
    return 1
  fi
  echo "O'Pip canonical writer resource validation: PASS"
}

paper_services() {
  docker compose -f "$PAPER_COMPOSE" config --services \
    | grep -E '^ohm-freqtrade-paper(-usdt)?$' || true
}

stop_paper_stack() {
  if [[ -s "$PAPER_COMPOSE" ]]; then
    docker compose -f "$PAPER_COMPOSE" stop >/dev/null 2>&1 || true
  fi
}

start_paper_stack() {
  [[ -s "$PAPER_COMPOSE" ]] || {
    echo "paper compose missing: $PAPER_COMPOSE" >&2
    return 1
  }
  docker compose -f "$PAPER_COMPOSE" up -d --remove-orphans
}

wait_paper_health() {
  local services service cid status all_healthy
  services="$(paper_services)"
  [[ -n "$services" ]] || {
    echo "no Freqtrade paper services declared" >&2
    return 1
  }

  for _ in $(seq 1 45); do
    all_healthy=1
    while IFS= read -r service; do
      [[ -n "$service" ]] || continue
      cid="$(docker compose -f "$PAPER_COMPOSE" ps -q "$service")"
      if [[ -z "$cid" ]]; then
        all_healthy=0
        continue
      fi
      status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
      if [[ "$status" != "healthy" ]]; then
        all_healthy=0
      fi
    done <<< "$services"

    if [[ "$all_healthy" == "1" ]] && docker compose exec -T ohm-trade-agent \
      python -c 'from app.services.freqtrade_result_ingest import freqtrade_dry_run_status; s=freqtrade_dry_run_status(); assert s.get("status") == "OK", s; assert s.get("mode") == "DRY_RUN", s; assert s.get("exchange_write_authority") is False, s; assert set((s.get("workers") or {}).keys()) == {"USD","USDT"}, s'; then
      return 0
    fi
    sleep 2
  done

  echo "Freqtrade paper topology failed health/authority validation" >&2
  docker compose -f "$PAPER_COMPOSE" ps >&2 || true
  return 1
}

validate_target_resource_budget() {
  local available_kb
  available_kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
  if [[ ! "$available_kb" =~ ^[0-9]+$ ]] || (( available_kb < 384 * 1024 )); then
    echo "insufficient host memory headroom after paper startup: available_kb=$available_kb" >&2
    return 1
  fi

  # Verify the intended hard cgroup ceilings landed on the running target,
  # rather than trusting only the YAML checked into this SHA.
  local name expected_mem expected_swap actual
  while IFS='|' read -r name expected_mem expected_swap; do
    actual="$(docker inspect --format='{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}' "$name" 2>/dev/null || true)"
    if [[ "$actual" != "$expected_mem|$expected_swap" ]]; then
      echo "resource limit mismatch: container=$name expected=$expected_mem|$expected_swap actual=$actual" >&2
      return 1
    fi
  done <<'LIMITS'
ohm-trade-agent|402653184|402653184
ohm-dashboard-edge|67108864|67108864
opip-canonical-writer|134217728|134217728
opip-stream-worker|201326592|201326592
ohm-freqtrade-paper|402653184|402653184
ohm-freqtrade-paper-usdt|402653184|402653184
LIMITS

  echo "O'Pip resource budget validation: PASS available_kb=$available_kb"
}

replace_file_atomically() {
  local source="$1"
  local target="$2"
  local tmp
  tmp="$(mktemp "${target}.restore.XXXXXX")"
  rm -f "$tmp"
  cp -a "$source" "$tmp"
  mv -f "$tmp" "$target"
}

capture_release_evidence_baseline() {
  # Cursor values are metadata only. Query through the running core container
  # with SQLite read-only mode, before stopping it or changing the checked-out SHA.
  docker compose exec -T ohm-trade-agent python -c '
import json, sqlite3
from app.opip.canonical.paths import db_path
path = db_path().resolve()
conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
try:
    result = {}
    for name, event_type in (
        ("feature_snapshot_cursor", "feature.snapshot.recorded"),
        ("feasibility_evidence_cursor", "feasibility.evidence.recorded"),
    ):
        row = conn.execute(
            "SELECT history_epoch, local_sequence FROM events WHERE event_type = ? "
            "ORDER BY history_epoch DESC, local_sequence DESC LIMIT 1",
            (event_type,),
        ).fetchone()
        result[name] = [int(row[0]), int(row[1])] if row else None
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))
finally:
    conn.close()
'
}

snapshot_scheduler_state() {
  SCHEDULER_SNAPSHOT="$(mktemp -d "$STATE_DIR/scheduler-before.XXXXXX")"
  for name in ohm-unified-cycle opip-learning-export opip-ml-evidence ohm-movement-discovery \
    opip-feature-bus-capture opip-feasibility-evidence-capture; do
    if [[ -e "/etc/cron.d/$name" ]]; then
      cp -a "/etc/cron.d/$name" "$SCHEDULER_SNAPSHOT/$name"
    fi
  done

  local source snapshot_name
  while IFS='|' read -r source snapshot_name; do
    if [[ -e "$source" ]]; then
      cp -a "$source" "$SCHEDULER_SNAPSHOT/$snapshot_name"
      : > "$SCHEDULER_SNAPSHOT/$snapshot_name.present"
    fi
  done <<OPS
$DEPLOY_SCRIPT_DST|remote-op-ohm-deploy
$SSH_GATEWAY_DST|remote-op-ohm-deploy-ssh
$LEARNING_READER_DST|remote-op-learning-reader
$LEARNING_DIAGNOSTICS_DST|remote-op-learning-diagnostics
OPS

  if crontab -l > "$SCHEDULER_SNAPSHOT/root.crontab" 2>/dev/null; then
    : > "$SCHEDULER_SNAPSHOT/root.crontab.present"
  else
    : > "$SCHEDULER_SNAPSHOT/root.crontab"
  fi
}

restore_scheduler_state() {
  [[ -n "$SCHEDULER_SNAPSHOT" && -d "$SCHEDULER_SNAPSHOT" ]] || return 0
  for name in ohm-unified-cycle opip-learning-export opip-ml-evidence ohm-movement-discovery \
    opip-feature-bus-capture opip-feasibility-evidence-capture; do
    if [[ -e "$SCHEDULER_SNAPSHOT/$name" ]]; then
      cp -a "$SCHEDULER_SNAPSHOT/$name" "/etc/cron.d/$name"
    else
      rm -f "/etc/cron.d/$name"
    fi
  done

  local target snapshot_name
  while IFS='|' read -r target snapshot_name; do
    if [[ -e "$SCHEDULER_SNAPSHOT/$snapshot_name.present" ]]; then
      replace_file_atomically "$SCHEDULER_SNAPSHOT/$snapshot_name" "$target"
    else
      rm -f "$target"
    fi
  done <<OPS
$DEPLOY_SCRIPT_DST|remote-op-ohm-deploy
$SSH_GATEWAY_DST|remote-op-ohm-deploy-ssh
$LEARNING_READER_DST|remote-op-learning-reader
$LEARNING_DIAGNOSTICS_DST|remote-op-learning-diagnostics
OPS

  if [[ -e "$SCHEDULER_SNAPSHOT/root.crontab.present" ]]; then
    crontab "$SCHEDULER_SNAPSHOT/root.crontab"
  else
    crontab -r 2>/dev/null || true
  fi
}

cleanup_snapshot() {
  if [[ -n "$SCHEDULER_SNAPSHOT" && -d "$SCHEDULER_SNAPSHOT" ]]; then
    rm -rf "$SCHEDULER_SNAPSHOT"
  fi
  rm -f "$SAFE_BASELINE_OVERRIDE"
}

#: Fail-closed abort disposal: PRESERVE the pre-deploy scheduler transaction
#: instead of deleting it. The snapshot is the only durable copy of the
#: pre-deploy cron.d entries, the root crontab and the installed remote-op
#: scripts, including any emergency containment that is newer than the previous
#: revision, so it is MOVED out of the `scheduler-before.*` namespace rather than
#: destroyed: leaving a transaction directory behind would break the
#: deploy-controller bootstrap's exactly-one-transaction proof on the next
#: deploy. The SAFE_BASELINE override is dropped because no rollback was applied,
#: and ownership of `SCHEDULER_SNAPSHOT` is cleared so nothing later restores
#: from a directory that is no longer there.
preserve_scheduler_snapshot_on_abort() {
  local preserved=""
  if [[ -n "${SCHEDULER_SNAPSHOT:-}" && -d "$SCHEDULER_SNAPSHOT" && ! -L "$SCHEDULER_SNAPSHOT" ]]; then
    preserved="$STATE_DIR/scheduler-recovery.${SCHEDULER_SNAPSHOT##*/}"
    if [[ -e "$preserved" ]]; then
      preserved="$preserved.$$"
    fi
    if mv -- "$SCHEDULER_SNAPSHOT" "$preserved"; then
      SCHEDULER_SNAPSHOT=""
    else
      preserved="$SCHEDULER_SNAPSHOT"
    fi
  fi
  echo "OPIP_ROLLBACK_SCHEDULER_SNAPSHOT_PRESERVED=$preserved"
  rm -f "$SAFE_BASELINE_OVERRIDE"
}

write_safe_baseline_override() {
  [[ "$PREVIOUS_SHA" =~ ^[0-9a-f]{40}$ ]] || {
    echo "SAFE_BASELINE rollback SHA is malformed" >&2
    return 1
  }
  umask 077
  cat > "$SAFE_BASELINE_OVERRIDE" <<PROFILE
services:
  ohm-trade-agent:
    environment:
      OPIP_RELEASE_PROFILE: "SAFE_BASELINE"
      OPIP_FEATURE_BUS_MODE: "off"
      OPIP_CANONICAL_WRITER_MODE: "off"
      OPIP_TARGET_SPINE_MODE: "off"
      OPIP_PAPER_V2_MODE: "off"
      OPIP_COMMITTEE_MODE: "off"
      OPIP_FEASIBILITY_CAPTURE_NOTIONAL_USD: "0.0"
    labels:
      org.opencontainers.image.revision: "$PREVIOUS_SHA"
PROFILE
}

validate_safe_baseline_modes() {
  local actual image_sha
  image_sha="$(docker inspect --format='{{ index .Config.Labels "org.opencontainers.image.revision" }}' ohm-trade-agent)"
  [[ "$image_sha" == "$PREVIOUS_SHA" ]] || {
    echo "SAFE_BASELINE rollback image SHA is unproven" >&2
    return 1
  }
  actual="$(docker inspect --format='{{range .Config.Env}}{{println .}}{{end}}' ohm-trade-agent \
    | grep -E '^OPIP_(RELEASE_PROFILE|FEATURE_BUS_MODE|CANONICAL_WRITER_MODE|TARGET_SPINE_MODE|PAPER_V2_MODE|COMMITTEE_MODE|FEASIBILITY_CAPTURE_NOTIONAL_USD)=')"
  for expected in \
    'OPIP_RELEASE_PROFILE=SAFE_BASELINE' \
    'OPIP_FEATURE_BUS_MODE=off' \
    'OPIP_CANONICAL_WRITER_MODE=off' \
    'OPIP_TARGET_SPINE_MODE=off' \
    'OPIP_PAPER_V2_MODE=off' \
    'OPIP_COMMITTEE_MODE=off' \
    'OPIP_FEASIBILITY_CAPTURE_NOTIONAL_USD=0.0'; do
    grep -Fxq "$expected" <<< "$actual" || {
      echo "SAFE_BASELINE rollback mode is unproven: $expected" >&2
      return 1
    }
  done
}

validate_release_scheduler_contract() {
  local matches
  local -a contracts=(
    'ohm-unified-cycle|python -m app.jobs.run_cycle|/var/run/ohm-unified-cycle.lock|timeout --signal=TERM'
    'opip-feature-bus-capture|python -m app.jobs.capture_feature_bus_shadow|/var/run/opip-feature-bus-capture.lock|timeout --signal=TERM'
    'opip-feasibility-evidence-capture|python -m app.jobs.capture_feasibility_evidence_shadow|/var/run/opip-feasibility-capture.lock|timeout --signal=TERM'
  )
  local item name command lock bound cron
  for item in "${contracts[@]}"; do
    IFS='|' read -r name command lock bound <<< "$item"
    cron="/etc/cron.d/$name"
    [[ -s "$cron" ]] || {
      echo "required release scheduler is missing: $name" >&2
      return 1
    }
    grep -Fq "$command" "$cron"
    grep -Fq "$lock" "$cron"
    grep -Fq "$bound" "$cron"
    grep -Fq 'flock -n' "$cron"
    matches="$(grep -RhE "^[*0-9/, -]+[[:space:]]+root .*${command//./\\.}" /etc/cron.d 2>/dev/null | wc -l)"
    [[ "$matches" -eq 1 ]] || {
      echo "release scheduler command is duplicated or missing: $name count=$matches" >&2
      return 1
    }
  done

  if crontab -l 2>/dev/null \
    | grep -Eq 'app\.jobs\.(run_cycle|capture_feature_bus_shadow|capture_feasibility_evidence_shadow)'; then
    echo "duplicate release scheduler command remains in root crontab" >&2
    return 1
  fi

  # --- release-scheduler lock verification (begin) --------------------------
  # Each evidence producer holds its OWN in-container process-level advisory
  # lock with a DISTINCT identity, so neither can suppress the other while each
  # still guarantees at most one of its own runs. A host `flock` alone cannot
  # prove this: killing the host Docker client does not reliably terminate the
  # process created inside the already-running container. The guard is therefore
  # verified against the producer SOURCES explicitly and diagnostically (a bare
  # `grep -Fq` under `set -e` fails silently and caused a release abort).
  local fb_producer feas_producer fb_identity feas_identity
  fb_producer="$APP_ROOT/app/jobs/capture_feature_bus_shadow.py"
  feas_producer="$APP_ROOT/app/jobs/capture_feasibility_evidence_shadow.py"

  [[ -s "$fb_producer" ]] || {
    echo "Feature Bus producer source is missing: $fb_producer" >&2
    return 1
  }
  [[ -s "$feas_producer" ]] || {
    echo "feasibility producer source is missing: $feas_producer" >&2
    return 1
  }

  # 1. The shared process-level lock implementation is present, and BOTH
  #    producers use the locked capture entrypoint.
  for required in 'class CaptureProcessLock' 'run_capture_locked'; do
    grep -Fq "$required" "$fb_producer" || {
      echo "process-level lock implementation is missing: $required" >&2
      return 1
    }
  done
  grep -Fq 'run_capture_locked(' "$feas_producer" || {
    echo "feasibility producer does not use the locked capture entrypoint" >&2
    return 1
  }

  # 2. Each producer's lock identity is a real path assignment, not a mention.
  #    `grep -m1` avoids a SIGPIPE under `pipefail`, and `|| true` keeps a
  #    no-match from aborting the release silently: the explicit diagnostics on
  #    the next lines must be the thing that fires.
  fb_identity="$(grep -m1 -oE '^FEATURE_BUS_CAPTURE_LOCK_PATH[[:space:]]*=[[:space:]]*"[^"]+"' "$fb_producer" 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/' || true)"
  feas_identity="$(grep -m1 -oE '^FEASIBILITY_CAPTURE_LOCK_PATH[[:space:]]*=[[:space:]]*"[^"]+"' "$feas_producer" 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/' || true)"
  [[ -n "$fb_identity" ]] || {
    echo "Feature Bus lock identity path is not defined (FEATURE_BUS_CAPTURE_LOCK_PATH) in $fb_producer" >&2
    return 1
  }
  [[ -n "$feas_identity" ]] || {
    echo "feasibility lock identity path is not defined (FEASIBILITY_CAPTURE_LOCK_PATH) in $feas_producer" >&2
    return 1
  }

  # 3. The two producers' lock identities must be DISTINCT.
  [[ "$fb_identity" != "$feas_identity" ]] || {
    echo "Feature Bus and feasibility producers share a lock identity: $fb_identity" >&2
    return 1
  }
  echo "OPIP_FEATURE_BUS_LOCK_IDENTITY=$fb_identity"
  echo "OPIP_FEASIBILITY_LOCK_IDENTITY=$feas_identity"
  echo "OPIP_RELEASE_SCHEDULER=UNIQUE_BOUNDED"
  # --- release-scheduler lock verification (end) ----------------------------
}

#: Bounded grace added to the authorized scheduler hard runtime bound so an
#: in-flight cycle can finish and one fresh cycle can be observed, covering cron
#: scheduling jitter (the cycle is scheduled on the one-minute grid). This is
#: explicit and finite; the wait is never unbounded.
UNIFIED_CYCLE_RELEASE_GRACE_SECONDS=120

#: The release runtime verifier keeps its OWN independent bounded window. It must
#: equal `app.services.release_runtime_verifier.MAX_WAIT_SECONDS` (a larger value
#: is rejected by the verifier); a test asserts the two stay equal.
RUNTIME_VERIFIER_TIMEOUT_SECONDS=360

#: Emergency containment margin for the verifier process. The outer `timeout` is
#: NOT the normal failure mechanism: an ordinary evidence deficiency must always
#: surface as the verifier's own structured FAIL receipt. The margin therefore has
#: to cover everything that happens OUTSIDE the verifier's self-timed window:
#:   * `docker compose exec` connect + container-side interpreter/import startup;
#:   * one in-flight bounded canonical read on expiry
#:     (`release_runtime_verifier.MAX_SINGLE_READ_SECONDS`, currently 10s);
#:   * receipt flush + `docker compose exec` teardown;
#:   * a reserve for host/container scheduling delay.
#: A test proves the margin exceeds MAX_SINGLE_READ_SECONDS plus that reserve.
RUNTIME_VERIFIER_CONTAINMENT_MARGIN_SECONDS=60

#: ---------------------------------------------------------------------------
#: Read-only unified-cycle wait-failure evidence (AC-013).
#:
#: "no successful unified cycle was observed" is the SYMPTOM, not the cause. On
#: this host that symptom has causes the structured log alone cannot separate:
#: the cron wrapper never ran; the wrapper ran but could not take its `flock`, so
#: NOTHING is appended to the log at all; or a cycle ran and was skipped behind
#: the in-container cycle lock, or died without printing its completion pair.
#: Naming which one it was turns a bounded blind wait into a receipt that is
#: diagnosable without an interactive investigation -- and it must happen HERE,
#: in the deploy log, because rollback restores the previous release's
#: diagnostics helper and would otherwise discard the evidence.
#:
#: Scope discipline: this reporter runs ONLY after the wait has already failed,
#: and it is strictly observational -- it opens no lock, takes no lock, starts no
#: cycle/container/scheduler, creates, truncates and deletes no file, and every
#: probe is individually failure-tolerant. It therefore cannot change the wait's
#: success semantics, and it can neither replace nor mask the original failure
#: reason. It never inspects the in-container cycle lock, because that would
#: require starting a process inside the production container.
#:
#: Leak discipline: the surfaced tail is line-bounded, byte-bounded, truncated per
#: line, and allowlisted to release markers and exception frames only -- never
#: arbitrary application output -- so a bounded diagnostic cannot become an
#: unintended evidence-export channel.
UNIFIED_CYCLE_DIAGNOSTIC_TAIL_LINES=200
UNIFIED_CYCLE_DIAGNOSTIC_TAIL_MATCHES=60
UNIFIED_CYCLE_DIAGNOSTIC_TAIL_BYTES=8000
UNIFIED_CYCLE_DIAGNOSTIC_LINE_BYTES=400
UNIFIED_CYCLE_DIAGNOSTIC_LINE_FILTER='^(OPIP_[A-Z0-9_]+=|OHM Unified Cycle skipped|Traceback \(most recent call last\)|  File |[A-Za-z_][A-Za-z0-9_.]*(Error|Exception)(:|$))'

#: Read-only lock-ownership probe. `flock(2)`/`fcntl(3)` locks are enumerated by
#: the kernel in ``/proc/locks`` as
#: ``<id>: <TYPE> <MODE> <ACCESS> <pid> <major>:<minor>:<inode>``, so matching the
#: lock file's OWN device:inode identifies a currently held lock WITHOUT taking,
#: releasing or deleting anything. `stat` reports the raw device number in hex,
#: which is decoded into the kernel's major/minor split. An undeterminable probe
#: reports UNKNOWN instead of guessing.
unified_cycle_lock_probe() {
  local path="$1" locks_file="${2:-/proc/locks}"
  local dev_hex ino dev major minor needle
  [[ -e "$path" ]] || { echo "MISSING"; return 0; }
  dev_hex="$(stat -c '%D' "$path" 2>/dev/null || true)"
  ino="$(stat -c '%i' "$path" 2>/dev/null || true)"
  [[ "$dev_hex" =~ ^[0-9a-fA-F]+$ && "$ino" =~ ^[0-9]+$ ]] || { echo "UNKNOWN"; return 0; }
  dev=$(( 16#$dev_hex ))
  major=$(( (dev >> 20) & 0xfff ))
  minor=$(( dev & 0xfffff ))
  needle="$(printf '%02x:%02x:%s' "$major" "$minor" "$ino")"
  if grep -qE " ${needle}([[:space:]]|$)" "$locks_file" 2>/dev/null; then
    echo "HELD"
  else
    echo "NOT_HELD"
  fi
}

report_unified_cycle_wait_failure() {
  local cycle_log="$1" ready_after="$2" reason="$3"
  local entry="/etc/cron.d/ohm-unified-cycle"
  local locks_file="/proc/locks"
  # Both overrides are inert in production: they are honored only under the same
  # explicit test marker the wait's own seams require, and they can only change a
  # diagnostic string -- never the wait's success semantics.
  if [[ "${OPIP_DEPLOY_TEST_SEAMS:-0}" == "1" ]]; then
    if [[ -n "${OPIP_RELEASE_SCHEDULER_ENTRY:-}" ]]; then
      entry="$OPIP_RELEASE_SCHEDULER_ENTRY"
    fi
    if [[ -n "${OPIP_RELEASE_LOCKS_FILE:-}" ]]; then
      locks_file="$OPIP_RELEASE_LOCKS_FILE"
    fi
  fi

  echo "OPIP_UNIFIED_CYCLE_WAIT_FAILURE=$reason"
  echo "OPIP_UNIFIED_CYCLE_WAIT_READY_AFTER=$ready_after"
  echo "OPIP_UNIFIED_CYCLE_DIAGNOSTIC=READ_ONLY"
  echo "OPIP_UNIFIED_CYCLE_TAIL_LINES_REQUESTED=$UNIFIED_CYCLE_DIAGNOSTIC_TAIL_LINES"
  echo "OPIP_UNIFIED_CYCLE_TAIL_BYTES_LIMIT=$UNIFIED_CYCLE_DIAGNOSTIC_TAIL_BYTES"

  local size mtime
  if [[ -s "$cycle_log" ]]; then
    echo "OPIP_UNIFIED_CYCLE_LOG_EXISTS=YES"
    size="$(wc -c < "$cycle_log" 2>/dev/null || true)"
    size="${size//[[:space:]]/}"
    echo "OPIP_UNIFIED_CYCLE_LOG_SIZE_BYTES=${size:-UNKNOWN}"
    mtime="$(date -u -r "$cycle_log" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    echo "OPIP_UNIFIED_CYCLE_LOG_MTIME_UTC=${mtime:-UNKNOWN}"
  else
    echo "OPIP_UNIFIED_CYCLE_LOG_EXISTS=NO"
    echo "OPIP_UNIFIED_CYCLE_LOG_SIZE_BYTES=UNKNOWN"
    echo "OPIP_UNIFIED_CYCLE_LOG_MTIME_UTC=UNKNOWN"
  fi

  # One bounded, non-locking read of the tail, reused for every derived field, so
  # the probe adds a single read of a hot log and never races the scheduler.
  # `grep -c` prints 0 and exits non-zero when nothing matches, so every pipeline
  # is guarded to keep `set -e` intact.
  local tail_lines scanned success_count degraded_count completed_count skip_count traceback_count
  tail_lines="$(tail -n "$UNIFIED_CYCLE_DIAGNOSTIC_TAIL_LINES" "$cycle_log" 2>/dev/null || true)"
  # Counted as NON-BLANK lines, so an absent or empty log reports 0 rather than 1.
  scanned="$(printf '%s\n' "$tail_lines" | grep -c '[^[:space:]]' || true)"
  success_count="$(printf '%s\n' "$tail_lines" | grep -c 'OPIP_UNIFIED_CYCLE_STATUS=SUCCESS' || true)"
  degraded_count="$(printf '%s\n' "$tail_lines" | grep -c 'OPIP_UNIFIED_CYCLE_STATUS=DEGRADED' || true)"
  completed_count="$(printf '%s\n' "$tail_lines" | grep -c 'OPIP_UNIFIED_CYCLE_COMPLETED_AT=' || true)"
  skip_count="$(printf '%s\n' "$tail_lines" | grep -c 'OHM Unified Cycle skipped' || true)"
  traceback_count="$(printf '%s\n' "$tail_lines" | grep -c 'Traceback (most recent call last)' || true)"
  echo "OPIP_UNIFIED_CYCLE_TAIL_SCANNED_LINES=$scanned"
  echo "OPIP_UNIFIED_CYCLE_TAIL_SUCCESS_COUNT=$success_count"
  echo "OPIP_UNIFIED_CYCLE_TAIL_DEGRADED_COUNT=$degraded_count"
  echo "OPIP_UNIFIED_CYCLE_TAIL_COMPLETED_COUNT=$completed_count"
  echo "OPIP_UNIFIED_CYCLE_TAIL_SKIPPED_COUNT=$skip_count"
  echo "OPIP_UNIFIED_CYCLE_TAIL_TRACEBACK_COUNT=$traceback_count"

  # SUCCESS and DEGRADED are the only statuses the release controller accepts, but
  # the tail is matched with a permissive shape so an unexpected third status is
  # surfaced verbatim instead of being silently ignored.
  local last_status last_completed last_phase completed_epoch now_epoch age
  last_status="$(printf '%s\n' "$tail_lines" | grep -oE 'OPIP_UNIFIED_CYCLE_STATUS=[A-Z_]+' | tail -n 1 | cut -d= -f2 || true)"
  last_completed="$(printf '%s\n' "$tail_lines" | grep -oE 'OPIP_UNIFIED_CYCLE_COMPLETED_AT=[^[:space:]]+' | tail -n 1 | cut -d= -f2 || true)"
  # The cycle emits a flushed phase marker as each phase is entered, so the last
  # phase reached survives even when the scheduler's hard bound killed the cycle
  # before it could write a status. That is what names the phase consuming the
  # window instead of leaving the timeout unexplained.
  last_phase="$(printf '%s\n' "$tail_lines" | grep -oE 'OPIP_UNIFIED_CYCLE_PHASE=[A-Z0-9_]+' | tail -n 1 | cut -d= -f2 || true)"
  echo "OPIP_UNIFIED_CYCLE_LAST_STATUS=${last_status:-NONE}"
  echo "OPIP_UNIFIED_CYCLE_LAST_COMPLETED_AT=${last_completed:-NONE}"
  echo "OPIP_UNIFIED_CYCLE_LAST_PHASE=${last_phase:-NONE}"
  completed_epoch="$(date -u -d "$last_completed" +%s 2>/dev/null || true)"
  now_epoch="$(date -u +%s)"
  if [[ "$completed_epoch" =~ ^[0-9]+$ ]] && (( completed_epoch <= now_epoch )); then
    age=$(( now_epoch - completed_epoch ))
    echo "OPIP_UNIFIED_CYCLE_LAST_COMPLETION_AGE_SECONDS=$age"
  else
    echo "OPIP_UNIFIED_CYCLE_LAST_COMPLETION_AGE_SECONDS=UNKNOWN"
  fi

  local cron_schedule cron_log_target
  if [[ -s "$entry" ]]; then
    echo "OPIP_UNIFIED_CYCLE_CRON_EXISTS=YES"
    # A cron.d entry is environment assignments plus exactly one schedule line.
    # Report the schedule only, never the command line, so the receipt cannot echo
    # unrelated host configuration.
    cron_schedule="$(awk '
      /^[[:space:]]*#/ {next}
      /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=/ {next}
      NF {print $1" "$2" "$3" "$4" "$5; exit}
    ' "$entry" 2>/dev/null || true)"
    echo "OPIP_UNIFIED_CYCLE_CRON_SCHEDULE=${cron_schedule:-UNKNOWN}"
    cron_log_target="$(grep -oE '>>[[:space:]]*/[^[:space:]]+' "$entry" 2>/dev/null | tail -n 1 | sed -E 's/^>>[[:space:]]*//' || true)"
    echo "OPIP_UNIFIED_CYCLE_CRON_LOG_TARGET=${cron_log_target:-UNKNOWN}"
  else
    echo "OPIP_UNIFIED_CYCLE_CRON_EXISTS=NO"
    echo "OPIP_UNIFIED_CYCLE_CRON_SCHEDULE=UNKNOWN"
    echo "OPIP_UNIFIED_CYCLE_CRON_LOG_TARGET=UNKNOWN"
  fi

  # The wrapper lock identity is read from the same installed entry the wrapper
  # uses, so the diagnosis follows the schedule instead of a hardcoded assumption.
  local lock_path lock_state lock_present lock_held failure_class
  lock_path="$(grep -m1 -oE 'flock -n [^[:space:]]+' "$entry" 2>/dev/null | awk '{print $3}' || true)"
  echo "OPIP_UNIFIED_CYCLE_HOST_LOCK_PATH=${lock_path:-UNKNOWN}"
  lock_state="$(unified_cycle_lock_probe "${lock_path:-/var/run/ohm-unified-cycle.lock}" "$locks_file")"
  case "$lock_state" in
    HELD) lock_present=YES; lock_held=YES ;;
    NOT_HELD) lock_present=YES; lock_held=NO ;;
    MISSING) lock_present=NO; lock_held=UNKNOWN ;;
    *) lock_present=UNKNOWN; lock_held=UNKNOWN ;;
  esac
  echo "OPIP_UNIFIED_CYCLE_HOST_LOCK_PRESENT=$lock_present"
  echo "OPIP_UNIFIED_CYCLE_HOST_LOCK_HELD=$lock_held"

  # Best-effort classification derived ONLY from the fields above; it never
  # asserts a cause the evidence cannot support (UNCLASSIFIED otherwise).
  failure_class="UNCLASSIFIED"
  if [[ "$lock_held" == "YES" ]]; then
    failure_class="HOST_WRAPPER_LOCK_HELD"
  elif (( scanned == 0 )); then
    failure_class="NO_CYCLE_LOG_ACTIVITY"
  elif (( skip_count > 0 && completed_count == 0 )); then
    failure_class="SKIPPED_BEHIND_RUNNING_CYCLE"
  fi
  echo "OPIP_UNIFIED_CYCLE_WAIT_FAILURE_CLASS=$failure_class"

  echo "OPIP_UNIFIED_CYCLE_TAIL"
  printf '%s\n' "$tail_lines" \
    | grep -E "$UNIFIED_CYCLE_DIAGNOSTIC_LINE_FILTER" 2>/dev/null \
    | tail -n "$UNIFIED_CYCLE_DIAGNOSTIC_TAIL_MATCHES" \
    | cut -c "1-$UNIFIED_CYCLE_DIAGNOSTIC_LINE_BYTES" \
    | head -c "$UNIFIED_CYCLE_DIAGNOSTIC_TAIL_BYTES" || true
  echo
  echo "OPIP_UNIFIED_CYCLE_TAIL_END"
}

#: Extract the authorized unified-cycle hard runtime bound from the installed
#: scheduler entry (``timeout --signal=TERM --kill-after=Ns <BOUND> ...'').
#: Returns the bound on stdout, or non-zero when it cannot be determined.
scheduler_hard_bound_seconds() {
  local entry="/etc/cron.d/ohm-unified-cycle" value
  # The path override is honored ONLY under an explicit test marker, so a
  # production deploy cannot be pointed at an arbitrary entry to extend the wait.
  if [[ "${OPIP_DEPLOY_TEST_SEAMS:-0}" == "1" && -n "${OPIP_RELEASE_SCHEDULER_ENTRY:-}" ]]; then
    entry="$OPIP_RELEASE_SCHEDULER_ENTRY"
  fi
  [[ -s "$entry" ]] || return 1
  value="$(grep -m1 -oE 'timeout --signal=TERM --kill-after=[0-9]+s [0-9]+' "$entry" 2>/dev/null \
    | grep -oE '[0-9]+$' || true)"
  [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 ]] || return 1
  printf '%s' "$value"
}

# ---------------------------------------------------------------------------
# Capture-producer disposition evidence
#
# The two evidence producers are separate bounded processes on the ONE scheduler,
# so their runtime disposition lives in their OWN logs and in the host launch
# locks -- never in the deploy log. When the runtime verifier fails on missing
# evidence, the release must therefore surface the producers' durable disposition
# itself: without it a stalled or bound-killed producer is indistinguishable from
# a silent evidence drop, and the deployed controller cannot be diagnosed from
# its own receipt.
#
# Read-only, bounded, and non-destructive: only each producer's own machine-
# readable ``OPIP_*_CAPTURE_PHASE=`` markers, the last few log lines, and a
# non-destructive host-launch-lock probe are emitted. No canonical store is
# opened, no producer is started, and no failure semantics change.
# ---------------------------------------------------------------------------
OPIP_CAPTURE_DISPOSITION_TAIL_LINES="${OPIP_CAPTURE_DISPOSITION_TAIL_LINES:-6}"

emit_capture_producer_disposition_evidence() {
  local entry label log lock marker line lock_state
  local -a producers=(
    'FEATURE_BUS|/var/log/opip-feature-bus-capture.log|/var/run/opip-feature-bus-capture.lock|OPIP_FEATURE_BUS_CAPTURE_PHASE'
    'FEASIBILITY|/var/log/opip-feasibility-capture.log|/var/run/opip-feasibility-capture.lock|OPIP_FEASIBILITY_CAPTURE_PHASE'
  )
  local tail_lines="$OPIP_CAPTURE_DISPOSITION_TAIL_LINES"
  [[ "$tail_lines" =~ ^[0-9]+$ ]] || tail_lines=6
  for entry in "${producers[@]}"; do
    IFS='|' read -r label log lock marker <<< "$entry"
    echo "OPIP_CAPTURE_PRODUCER=$label"
    if [[ -s "$log" ]]; then
      echo "OPIP_CAPTURE_LOG_BYTES=$(wc -c < "$log" 2>/dev/null || printf 'UNKNOWN')"
      echo "OPIP_CAPTURE_LOG_MTIME_UTC=$(date -u -r "$log" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'UNKNOWN')"
    else
      echo "OPIP_CAPTURE_LOG_MISSING=1"
    fi
    # The LAST durable producer marker names the stage that overran, if any.
    local last_marker
    last_marker="$(grep -oE "${marker}=[^[:space:]]+.*" "$log" 2>/dev/null | tail -n 1 || true)"
    echo "OPIP_CAPTURE_LAST_MARKER=${last_marker:-NONE}"
    while IFS= read -r line; do
      echo "OPIP_CAPTURE_TAIL=${label}|${line}"
    done < <(tail -n "$tail_lines" "$log" 2>/dev/null || true)
    # A held host launch lock is direct evidence that a producer pass was still
    # running inside its bound while the release transaction executed. The probe
    # acquires and immediately releases, so it never blocks a producer.
    if [[ -e "$lock" ]]; then
      if flock -n "$lock" true 2>/dev/null; then
        lock_state="PRESENT|HELD=NO"
      else
        lock_state="PRESENT|HELD=YES"
      fi
      echo "OPIP_CAPTURE_HOST_LOCK=${label}|${lock_state}"
    else
      echo "OPIP_CAPTURE_HOST_LOCK=${label}|ABSENT"
    fi
  done
  return 0
}

wait_unified_cycle_success() {
  local ready_after="$1" deadline="$2"
  local cycle_log="/var/log/ohm-unified-cycle.log"
  # The log override is honored ONLY under an explicit test marker, so a
  # production deploy cannot be pointed at a forged log to fake the success signal.
  if [[ "${OPIP_DEPLOY_TEST_SEAMS:-0}" == "1" && -n "${OPIP_RELEASE_CYCLE_LOG:-}" ]]; then
    cycle_log="$OPIP_RELEASE_CYCLE_LOG"
  fi
  local status completed_at completed_epoch ready_epoch
  ready_epoch="$(date -u -d "$ready_after" +%s)"
  while (( SECONDS < deadline )); do
    status="$(grep -oE 'OPIP_UNIFIED_CYCLE_STATUS=(SUCCESS|DEGRADED)' \
      "$cycle_log" 2>/dev/null | tail -n 1 | cut -d= -f2 || true)"
    completed_at="$(grep -oE 'OPIP_UNIFIED_CYCLE_COMPLETED_AT=[^[:space:]]+' \
      "$cycle_log" 2>/dev/null | tail -n 1 | cut -d= -f2 || true)"
    if [[ -n "$status" && -n "$completed_at" ]]; then
      completed_epoch="$(date -u -d "$completed_at" +%s 2>/dev/null || true)"
      # A stale pre-readiness completion is not proof: only a cycle that
      # completed at or after candidate readiness counts.
      if [[ "$completed_epoch" =~ ^[0-9]+$ ]] && (( completed_epoch >= ready_epoch )); then
        [[ "$status" == "SUCCESS" ]] || {
          echo "unified cycle reported DEGRADED after candidate readiness" >&2
          report_unified_cycle_wait_failure "$cycle_log" "$ready_after" DEGRADED_AFTER_READINESS
          return 1
        }
        echo "OPIP_UNIFIED_CYCLE=HEALTHY"
        echo "OPIP_UNIFIED_CYCLE_COMPLETED_AT=$completed_at"
        return 0
      fi
    fi
    sleep 5
  done
  echo "no successful unified cycle was observed within the bounded release window" >&2
  report_unified_cycle_wait_failure "$cycle_log" "$ready_after" NO_FRESH_COMPLETION
  return 1
}

validate_candidate_container_identity() {
  local image_sha actual profile expected
  local -a expected_modes
  image_sha="$(docker inspect --format='{{ index .Config.Labels "org.opencontainers.image.revision" }}' ohm-trade-agent)"
  [[ "$image_sha" == "$TARGET_SHA" ]] || {
    echo "candidate container image SHA does not match the approved SHA" >&2
    return 1
  }
  actual="$(docker inspect --format='{{range .Config.Env}}{{println .}}{{end}}' ohm-trade-agent \
    | grep -E '^OPIP_(RELEASE_PROFILE|FEATURE_BUS_MODE|CANONICAL_WRITER_MODE|TARGET_SPINE_MODE|PAPER_V2_MODE|COMMITTEE_MODE)=')"
  profile="$(grep -E '^OPIP_RELEASE_PROFILE=' <<< "$actual" | cut -d= -f2)"
  case "$profile" in
    EVIDENCE_SHADOW)
      expected_modes=(
        'OPIP_FEATURE_BUS_MODE=shadow'
        'OPIP_CANONICAL_WRITER_MODE=shadow'
        'OPIP_TARGET_SPINE_MODE=shadow'
        'OPIP_PAPER_V2_MODE=off'
        'OPIP_COMMITTEE_MODE=off'
      )
      ;;
    *)
      echo "candidate container release profile is not deployable: ${profile:-missing}; SAFE_BASELINE is rollback-only" >&2
      return 1
      ;;
  esac
  grep -Fxq "OPIP_RELEASE_PROFILE=$profile" <<< "$actual" || {
    echo "candidate container release profile is missing or ambiguous" >&2
    return 1
  }
  for expected in "${expected_modes[@]}"; do
    grep -Fxq "$expected" <<< "$actual" || {
      echo "candidate container mode does not match $profile: $expected" >&2
      return 1
    }
  done
  echo "OPIP_RELEASE_PROFILE=$profile"
}

