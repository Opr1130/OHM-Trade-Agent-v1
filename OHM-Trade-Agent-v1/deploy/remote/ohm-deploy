#: The rollback quiescence barrier. Removes the candidate producer schedule,
#: takes BOTH producer host launch locks with a bounded wait, proves zero
#: in-container producers, and RETURNS NONZERO unless every one of those proofs
#: succeeded. On success the launch locks are deliberately LEFT HELD so the
#: caller completes the canonical-writer recovery under the barrier and releases
#: them only after SAFE_BASELINE is proven.
quiesce_evidence_producers() {
  local name removed=0
  for name in "${EVIDENCE_PRODUCER_CRON_ENTRIES[@]}"; do
    if [[ -e "/etc/cron.d/$name" ]]; then
      rm -f "/etc/cron.d/$name"
      removed=$((removed + 1))
    fi
  done
  echo "OPIP_EVIDENCE_PRODUCER_ENTRIES_REMOVED=$removed"

  # Barrier BEFORE any process proof: once both host launch locks are held, a
  # late cron wrapper cannot start a producer (`flock -n` fails), and a wrapper
  # that was already launched has finished. A failure to establish the barrier is
  # fail-closed.
  if ! acquire_evidence_producer_locks; then
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE=FAILED" >&2
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE_REASON=$EVIDENCE_PRODUCER_QUIESCENCE_REASON" >&2
    return 1
  fi

  if ! producer_process_quiescence; then
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE=FAILED" >&2
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE_REASON=$EVIDENCE_PRODUCER_QUIESCENCE_REASON" >&2
    return 1
  fi

  # NO_CONTAINER is a PROVEN absence (no core container => no producer process),
  # distinct from the UNKNOWN/NOT_QUIESCED failure states above.
  if [[ "$EVIDENCE_PRODUCER_PROCESS_STATE" == "NO_CONTAINER" ]]; then
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE=NO_CONTAINER"
  else
    echo "OPIP_EVIDENCE_PRODUCER_QUIESCENCE=QUIESCED"
  fi
  return 0
}

#: Bounded diagnostics for a writer that did not become healthy, detailed enough
#: to tell the operator which of the five realistic failure classes occurred:
#: process crash, store-lock contention, SQLite/schema/integrity failure, a stale
#: Unix socket, or a pure container healthcheck failure.
writer_health_diagnostics() {
  local cid status exit_code restarts log classification
  cid="$(docker compose ps -q opip-canonical-writer 2>/dev/null || true)"
  if [[ -z "$cid" ]]; then
    echo "OPIP_WRITER_DIAG=NO_CONTAINER" >&2
    return 0
  fi
  status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
  exit_code="$(docker inspect --format='{{.State.ExitCode}}' "$cid" 2>/dev/null || true)"
  restarts="$(docker inspect --format='{{.RestartCount}}' "$cid" 2>/dev/null || true)"
  echo "OPIP_WRITER_DIAG_HEALTH=$status" >&2
  echo "OPIP_WRITER_DIAG_EXIT_CODE=$exit_code" >&2
  echo "OPIP_WRITER_DIAG_RESTART_COUNT=$restarts" >&2

  # One bounded log window carries the fail-closed reason; classification is by
  # the exception/OS token the writer itself logs.
  log="$(docker compose logs --tail=200 --no-log-prefix opip-canonical-writer 2>/dev/null || true)"
  case "$log" in
    *CanonicalStoreBusyError*)
      classification="STORE_LOCK_CONTENTION" ;;
    *CanonicalDbValidationError*|*SchemaVersionError*|*CanonicalCheckpointError*|*"database disk image is malformed"*|*"file is not a database"*|*"no such table"*)
      classification="SQLITE_SCHEMA_OR_INTEGRITY" ;;
    *"Address already in use"*|*"Errno 98"*|*"AF_UNIX"*)
      classification="STALE_UNIX_SOCKET" ;;
    *Traceback*)
      classification="WRITER_PROCESS_CRASH" ;;
    *)
      classification="CONTAINER_HEALTHCHECK_OR_STARTUP" ;;
  esac
  echo "OPIP_WRITER_DIAG_CLASSIFICATION=$classification" >&2
  echo "OPIP_WRITER_DIAG_LOG_BEGIN" >&2
  printf '%s\n' "$log" | tail -n 40 >&2 || true
  echo "OPIP_WRITER_DIAG_LOG_END" >&2
  return 0
}

rollback() {
  rc=$?
  trap - ERR
  # Explicit core-failure marker so the workflow never has to infer core state
  # from an exit code alone.
  echo "OPIP_CORE_DEPLOY_STATUS=FAILED"
  echo "deployment failed; rolling back to $PREVIOUS_SHA" >&2

  # Surface the capture producers' OWN durable disposition when the runtime
  # verifier is what failed, BEFORE any rollback work: a missing-evidence failure
  # must be diagnosable from the deploy receipt alone. Bounded and read-only.
  # ``${VAR:-}`` keeps this safe under ``set -u`` when the controller's globals
  # are not in scope (for example the AC-015 rollback-control-flow harness).
  if [[ "${RELEASE_RUNTIME_VERIFIER_ATTEMPTED:-}" == "1" ]]; then
    echo "OPIP_RELEASE_RUNTIME_VERIFIER_EXIT=$rc"
    emit_capture_producer_disposition_evidence || true
  fi

  # Free paper-worker memory before rebuilding the previous deterministic core.
  stop_paper_stack

  # Quiesce candidate evidence producers BEFORE any rebuild. The candidate's
  # producer schedule is still installed and its producers run inside the
  # candidate core container, which stays up through the whole build window. A
  # producer that starts inside the writer-rebuild window can win the canonical
  # store lock from the about-to-restore writer, which then fails closed and can
  # never report healthy inside the bounded writer health window.
  #
  # FAIL CLOSED: the barrier is a PRECONDITION for resetting the SHA or
  # restarting the previous writer. If the bounded host-launch-lock wait expires,
  # the producer process state is unprovable, the exec fails, or a producer
  # survives TERM/KILL, rollback MUST NOT touch the canonical writer. On success
  # `quiesce_evidence_producers` leaves BOTH host launch locks HELD so no late
  # cron wrapper can start a producer during writer recovery.
  if ! quiesce_evidence_producers; then
    echo "OPIP_ROLLBACK_ABORTED=PRODUCER_QUIESCENCE_UNPROVEN" >&2
    echo "OPIP_SAFE_BASELINE_ROLLBACK=UNPROVEN" >&2
    # The candidate producer schedule was removed and is deliberately NOT
    # restored: re-arming producers whose quiescence is unproven is the exact
    # race this barrier exists to prevent. The pre-deploy scheduler transaction is
    # PRESERVED, never deleted: it is the only durable copy of the pre-deploy
    # cron.d entries, root crontab and installed remote-op scripts, so a later
    # operator-driven recovery is still possible from a fail-closed abort.
    preserve_scheduler_snapshot_on_abort
    exit "$rc"
  fi

  "${GIT[@]}" checkout -f main
  "${GIT[@]}" reset --hard "$PREVIOUS_SHA"
  cd "$APP_ROOT"
  [[ "$("${GIT[@]}" rev-parse HEAD)" == "$PREVIOUS_SHA" ]] || {
    echo "rollback code SHA does not match the selected previous SHA" >&2
    false
  }
  write_safe_baseline_override

  # First PR 2 deploy may roll back to a SHA that does not declare the writer.
  # Detect Compose services after reset; never require a missing service.
  if docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
    config --services 2>/dev/null | grep -qx 'opip-canonical-writer'; then
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      build --build-arg "OPIP_RELEASE_SHA=$PREVIOUS_SHA" \
      opip-canonical-writer ohm-trade-agent
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans opip-canonical-writer
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans ohm-trade-agent
    if ! wait_core_health; then
      echo "rollback core health check failed" >&2
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
    if ! wait_writer_health; then
      echo "rollback writer health check failed" >&2
      writer_health_diagnostics
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
  else
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      build --build-arg "OPIP_RELEASE_SHA=$PREVIOUS_SHA" ohm-trade-agent
    # --remove-orphans drops a writer left from the failed PR 2 attempt.
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans ohm-trade-agent
    if ! wait_core_health; then
      echo "rollback core health check failed" >&2
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
  fi

  if ! validate_safe_baseline_modes; then
    echo "SAFE_BASELINE rollback mode validation failed" >&2
    restore_scheduler_state
    cleanup_snapshot
    exit "$rc"
  fi

  # Restore the exact scheduler state that was installed before this deploy.
  # This preserves any emergency production containment that is newer than the
  # previous repository revision. It happens while the launch locks are STILL
  # held, so a cron tick inside this window cannot start a producer; only after
  # SAFE_BASELINE is fully proven are the held locks released.
  restore_scheduler_state
  release_evidence_producer_locks

  if ! start_paper_stack || ! wait_paper_health; then
    echo "rollback paper topology validation failed" >&2
    cleanup_snapshot
    exit "$rc"
  fi

  printf '%s\n' "$PREVIOUS_SHA" > "$LAST_GOOD_FILE"
  cleanup_snapshot
  echo "OPIP_SAFE_BASELINE_ROLLBACK=SUCCESS"
  echo "rollback health and paper checks passed" >&2
  exit "$rc"
}
