#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_SHA="${1:-}"
REPO_ROOT="/opt/OHM-Trade-Agent-v1"
APP_ROOT="$REPO_ROOT/OHM-Trade-Agent-v1"
DATA_ROOT="$APP_ROOT/data"
# Same interpreter convention as the rest of the production scripts.
PYTHON_BIN="${OPIP_PYTHON_BIN:-/usr/bin/python3}"
DEPLOY_SCRIPT_DST="/usr/local/sbin/ohm-deploy"
SSH_GATEWAY_DST="/usr/local/sbin/ohm-deploy-ssh"
LEARNING_READER_DST="/usr/local/sbin/opip-learning-read-export"
LEARNING_DIAGNOSTICS_DST="/usr/local/sbin/diagnose-opip-learning"
P1_RETIRE_SCRIPT="$APP_ROOT/deploy/remote/retire-p1-shadow-outbox.sh"
LEARNING_EXPORTER="$APP_ROOT/deploy/remote/export-opip-learning-evidence.sh"

if [[ "$TARGET_SHA" == "diagnose-learning" ]]; then
  [[ -x "$LEARNING_DIAGNOSTICS_DST" ]] || {
    echo "learning diagnostics helper is not installed" >&2
    exit 69
  }
  exec "$LEARNING_DIAGNOSTICS_DST"
fi
LOCK_FILE="/var/lock/ohm-deploy.lock"
STATE_DIR="/var/lib/ohm-deploy"
LAST_GOOD_FILE="$STATE_DIR/last-good-sha"
SAFE_BASELINE_OVERRIDE="$STATE_DIR/safe-baseline-rollback.override.yml"
# Durable paper-registry initialization provenance. Lives in host operational
# state so it outlives the registry it protects and never becomes evidence a
# reader could be handed. See app/services/paper_registry_genesis.py.
PAPER_GENESIS_MARKER="$STATE_DIR/paper-registry-initialized-v1"
SCHEDULER_RECONCILE="$APP_ROOT/deploy/remote/reconcile-scheduler.sh"
PAPER_COMPOSE="$APP_ROOT/docker-compose.paper.yml"
# Export root and proof bounds, mirroring the exporter and the verification
# helper. Kept explicit here so the deploy gate cannot drift from them.
EXPORT_ROOT="/var/lib/opip-learning-export"
EXPORT_PROOF_FRESHNESS_SECONDS=600
EXPORT_PROOF_WAIT_SECONDS=360
SCHEDULER_SNAPSHOT=""

if [[ ! "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "invalid target sha" >&2
  exit 64
fi

install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 75
fi

REPO_OWNER="$(stat -c '%U' "$REPO_ROOT/.git")"
GIT=(sudo -u "$REPO_OWNER" git -C "$REPO_ROOT")

wait_core_health() {
  local healthy=0
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error http://127.0.0.1:8000/health \
      | grep -q '"status":"ok"'; then
      healthy=1
      break
    fi
    sleep 2
  done
  [[ "$healthy" == "1" ]]
}

wait_writer_health() {
  # Writer health is validated separately from core. Core must never depend on
  # writer availability to start; this check only gates a successful deploy of
  # the PR 2 service itself.
  local cid status
  for _ in $(seq 1 30); do
    cid="$(docker compose ps -q opip-canonical-writer 2>/dev/null || true)"
    if [[ -n "$cid" ]]; then
      status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
      if [[ "$status" == "healthy" ]]; then
        return 0
      fi
    fi
    sleep 2
  done
  echo "opip-canonical-writer health check failed" >&2
  docker compose ps opip-canonical-writer >&2 || true
  return 1
}

validate_writer_resource_limits() {
  local actual expected_mem expected_swap expected_nano expected_pids
  expected_mem=134217728
  expected_swap=134217728
  expected_nano=150000000
  expected_pids=64
  actual="$(docker inspect --format='{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}|{{.HostConfig.NanoCpus}}|{{.HostConfig.PidsLimit}}' opip-canonical-writer 2>/dev/null || true)"
  if [[ "$actual" != "${expected_mem}|${expected_swap}|${expected_nano}|${expected_pids}" ]]; then
    echo "writer resource limit mismatch: expected=${expected_mem}|${expected_swap}|${expected_nano}|${expected_pids} actual=$actual" >&2
    return 1
  fi
  echo "O'Pip canonical writer resource validation: PASS"
}

paper_services() {
  docker compose -f "$PAPER_COMPOSE" config --services \
    | grep -E '^ohm-freqtrade-paper(-usdt)?$' || true
}

stop_paper_stack() {
  if [[ -s "$PAPER_COMPOSE" ]]; then
    docker compose -f "$PAPER_COMPOSE" stop >/dev/null 2>&1 || true
  fi
}

start_paper_stack() {
  [[ -s "$PAPER_COMPOSE" ]] || {
    echo "paper compose missing: $PAPER_COMPOSE" >&2
    return 1
  }
  docker compose -f "$PAPER_COMPOSE" up -d --remove-orphans
}

wait_paper_health() {
  local services service cid status all_healthy
  services="$(paper_services)"
  [[ -n "$services" ]] || {
    echo "no Freqtrade paper services declared" >&2
    return 1
  }

  for _ in $(seq 1 45); do
    all_healthy=1
    while IFS= read -r service; do
      [[ -n "$service" ]] || continue
      cid="$(docker compose -f "$PAPER_COMPOSE" ps -q "$service")"
      if [[ -z "$cid" ]]; then
        all_healthy=0
        continue
      fi
      status="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
      if [[ "$status" != "healthy" ]]; then
        all_healthy=0
      fi
    done <<< "$services"

    if [[ "$all_healthy" == "1" ]] && docker compose exec -T ohm-trade-agent \
      python -c 'from app.services.freqtrade_result_ingest import freqtrade_dry_run_status; s=freqtrade_dry_run_status(); assert s.get("status") == "OK", s; assert s.get("mode") == "DRY_RUN", s; assert s.get("exchange_write_authority") is False, s; assert set((s.get("workers") or {}).keys()) == {"USD","USDT"}, s'; then
      return 0
    fi
    sleep 2
  done

  echo "Freqtrade paper topology failed health/authority validation" >&2
  docker compose -f "$PAPER_COMPOSE" ps >&2 || true
  return 1
}

validate_target_resource_budget() {
  local available_kb
  available_kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
  if [[ ! "$available_kb" =~ ^[0-9]+$ ]] || (( available_kb < 384 * 1024 )); then
    echo "insufficient host memory headroom after paper startup: available_kb=$available_kb" >&2
    return 1
  fi

  # Verify the intended hard cgroup ceilings landed on the running target,
  # rather than trusting only the YAML checked into this SHA.
  local name expected_mem expected_swap actual
  while IFS='|' read -r name expected_mem expected_swap; do
    actual="$(docker inspect --format='{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}' "$name" 2>/dev/null || true)"
    if [[ "$actual" != "$expected_mem|$expected_swap" ]]; then
      echo "resource limit mismatch: container=$name expected=$expected_mem|$expected_swap actual=$actual" >&2
      return 1
    fi
  done <<'LIMITS'
ohm-trade-agent|402653184|402653184
ohm-dashboard-edge|67108864|67108864
opip-canonical-writer|134217728|134217728
opip-stream-worker|201326592|201326592
ohm-freqtrade-paper|402653184|402653184
ohm-freqtrade-paper-usdt|402653184|402653184
LIMITS

  echo "O'Pip resource budget validation: PASS available_kb=$available_kb"
}

replace_file_atomically() {
  local source="$1"
  local target="$2"
  local tmp
  tmp="$(mktemp "${target}.restore.XXXXXX")"
  rm -f "$tmp"
  cp -a "$source" "$tmp"
  mv -f "$tmp" "$target"
}

capture_release_evidence_baseline() {
  # Cursor values are metadata only. Query through the running core container
  # with SQLite read-only mode, before stopping it or changing the checked-out SHA.
  docker compose exec -T ohm-trade-agent python -c '
import json, sqlite3
from app.opip.canonical.paths import db_path
path = db_path().resolve()
conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
try:
    result = {}
    for name, event_type in (
        ("feature_snapshot_cursor", "feature.snapshot.recorded"),
        ("feasibility_evidence_cursor", "feasibility.evidence.recorded"),
    ):
        row = conn.execute(
            "SELECT history_epoch, local_sequence FROM events WHERE event_type = ? "
            "ORDER BY history_epoch DESC, local_sequence DESC LIMIT 1",
            (event_type,),
        ).fetchone()
        result[name] = [int(row[0]), int(row[1])] if row else None
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))
finally:
    conn.close()
'
}

snapshot_scheduler_state() {
  SCHEDULER_SNAPSHOT="$(mktemp -d "$STATE_DIR/scheduler-before.XXXXXX")"
  for name in ohm-unified-cycle opip-learning-export opip-ml-evidence ohm-movement-discovery; do
    if [[ -e "/etc/cron.d/$name" ]]; then
      cp -a "/etc/cron.d/$name" "$SCHEDULER_SNAPSHOT/$name"
    fi
  done

  local source snapshot_name
  while IFS='|' read -r source snapshot_name; do
    if [[ -e "$source" ]]; then
      cp -a "$source" "$SCHEDULER_SNAPSHOT/$snapshot_name"
      : > "$SCHEDULER_SNAPSHOT/$snapshot_name.present"
    fi
  done <<OPS
$DEPLOY_SCRIPT_DST|remote-op-ohm-deploy
$SSH_GATEWAY_DST|remote-op-ohm-deploy-ssh
$LEARNING_READER_DST|remote-op-learning-reader
$LEARNING_DIAGNOSTICS_DST|remote-op-learning-diagnostics
OPS

  if crontab -l > "$SCHEDULER_SNAPSHOT/root.crontab" 2>/dev/null; then
    : > "$SCHEDULER_SNAPSHOT/root.crontab.present"
  else
    : > "$SCHEDULER_SNAPSHOT/root.crontab"
  fi
}

restore_scheduler_state() {
  [[ -n "$SCHEDULER_SNAPSHOT" && -d "$SCHEDULER_SNAPSHOT" ]] || return 0
  for name in ohm-unified-cycle opip-learning-export opip-ml-evidence ohm-movement-discovery; do
    if [[ -e "$SCHEDULER_SNAPSHOT/$name" ]]; then
      cp -a "$SCHEDULER_SNAPSHOT/$name" "/etc/cron.d/$name"
    else
      rm -f "/etc/cron.d/$name"
    fi
  done

  local target snapshot_name
  while IFS='|' read -r target snapshot_name; do
    if [[ -e "$SCHEDULER_SNAPSHOT/$snapshot_name.present" ]]; then
      replace_file_atomically "$SCHEDULER_SNAPSHOT/$snapshot_name" "$target"
    else
      rm -f "$target"
    fi
  done <<OPS
$DEPLOY_SCRIPT_DST|remote-op-ohm-deploy
$SSH_GATEWAY_DST|remote-op-ohm-deploy-ssh
$LEARNING_READER_DST|remote-op-learning-reader
$LEARNING_DIAGNOSTICS_DST|remote-op-learning-diagnostics
OPS

  if [[ -e "$SCHEDULER_SNAPSHOT/root.crontab.present" ]]; then
    crontab "$SCHEDULER_SNAPSHOT/root.crontab"
  else
    crontab -r 2>/dev/null || true
  fi
}

cleanup_snapshot() {
  if [[ -n "$SCHEDULER_SNAPSHOT" && -d "$SCHEDULER_SNAPSHOT" ]]; then
    rm -rf "$SCHEDULER_SNAPSHOT"
  fi
  rm -f "$SAFE_BASELINE_OVERRIDE"
}

write_safe_baseline_override() {
  [[ "$PREVIOUS_SHA" =~ ^[0-9a-f]{40}$ ]] || {
    echo "SAFE_BASELINE rollback SHA is malformed" >&2
    return 1
  }
  umask 077
  cat > "$SAFE_BASELINE_OVERRIDE" <<PROFILE
services:
  ohm-trade-agent:
    environment:
      OPIP_RELEASE_PROFILE: "SAFE_BASELINE"
      OPIP_FEATURE_BUS_MODE: "off"
      OPIP_CANONICAL_WRITER_MODE: "off"
      OPIP_TARGET_SPINE_MODE: "off"
      OPIP_PAPER_V2_MODE: "off"
      OPIP_COMMITTEE_MODE: "off"
      OPIP_FEASIBILITY_CAPTURE_NOTIONAL_USD: "0.0"
    labels:
      org.opencontainers.image.revision: "$PREVIOUS_SHA"
PROFILE
}

validate_safe_baseline_modes() {
  local actual image_sha
  image_sha="$(docker inspect --format='{{ index .Config.Labels "org.opencontainers.image.revision" }}' ohm-trade-agent)"
  [[ "$image_sha" == "$PREVIOUS_SHA" ]] || {
    echo "SAFE_BASELINE rollback image SHA is unproven" >&2
    return 1
  }
  actual="$(docker inspect --format='{{range .Config.Env}}{{println .}}{{end}}' ohm-trade-agent \
    | grep -E '^OPIP_(RELEASE_PROFILE|FEATURE_BUS_MODE|CANONICAL_WRITER_MODE|TARGET_SPINE_MODE|PAPER_V2_MODE|COMMITTEE_MODE|FEASIBILITY_CAPTURE_NOTIONAL_USD)=')"
  for expected in \
    'OPIP_RELEASE_PROFILE=SAFE_BASELINE' \
    'OPIP_FEATURE_BUS_MODE=off' \
    'OPIP_CANONICAL_WRITER_MODE=off' \
    'OPIP_TARGET_SPINE_MODE=off' \
    'OPIP_PAPER_V2_MODE=off' \
    'OPIP_COMMITTEE_MODE=off' \
    'OPIP_FEASIBILITY_CAPTURE_NOTIONAL_USD=0.0'; do
    grep -Fxq "$expected" <<< "$actual" || {
      echo "SAFE_BASELINE rollback mode is unproven: $expected" >&2
      return 1
    }
  done
}

validate_release_scheduler_contract() {
  local matches
  local -a contracts=(
    'ohm-unified-cycle|python -m app.jobs.run_cycle|/var/run/ohm-unified-cycle.lock|timeout --signal=TERM'
    'opip-feature-bus-capture|python -m app.jobs.capture_feature_bus_shadow|/var/run/opip-feature-bus-capture.lock|timeout --signal=TERM'
    'opip-feasibility-evidence-capture|python -m app.jobs.capture_feasibility_evidence_shadow|/var/run/opip-feasibility-capture.lock|timeout --signal=TERM'
  )
  local item name command lock bound cron
  for item in "${contracts[@]}"; do
    IFS='|' read -r name command lock bound <<< "$item"
    cron="/etc/cron.d/$name"
    [[ -s "$cron" ]] || {
      echo "required release scheduler is missing: $name" >&2
      return 1
    }
    grep -Fq "$command" "$cron"
    grep -Fq "$lock" "$cron"
    grep -Fq "$bound" "$cron"
    grep -Fq 'flock -n' "$cron"
    matches="$(grep -RhE "^[*0-9/, -]+[[:space:]]+root .*${command//./\\.}" /etc/cron.d 2>/dev/null | wc -l)"
    [[ "$matches" -eq 1 ]] || {
      echo "release scheduler command is duplicated or missing: $name count=$matches" >&2
      return 1
    }
  done

  if crontab -l 2>/dev/null \
    | grep -Eq 'app\.jobs\.(run_cycle|capture_feature_bus_shadow|capture_feasibility_evidence_shadow)'; then
    echo "duplicate release scheduler command remains in root crontab" >&2
    return 1
  fi

  # --- release-scheduler lock verification (begin) --------------------------
  # Each evidence producer holds its OWN in-container process-level advisory
  # lock with a DISTINCT identity, so neither can suppress the other while each
  # still guarantees at most one of its own runs. A host `flock` alone cannot
  # prove this: killing the host Docker client does not reliably terminate the
  # process created inside the already-running container. The guard is therefore
  # verified against the producer SOURCES explicitly and diagnostically (a bare
  # `grep -Fq` under `set -e` fails silently and caused a release abort).
  local fb_producer feas_producer fb_identity feas_identity
  fb_producer="$APP_ROOT/app/jobs/capture_feature_bus_shadow.py"
  feas_producer="$APP_ROOT/app/jobs/capture_feasibility_evidence_shadow.py"

  [[ -s "$fb_producer" ]] || {
    echo "Feature Bus producer source is missing: $fb_producer" >&2
    return 1
  }
  [[ -s "$feas_producer" ]] || {
    echo "feasibility producer source is missing: $feas_producer" >&2
    return 1
  }

  # 1. The shared process-level lock implementation is present, and BOTH
  #    producers use the locked capture entrypoint.
  for required in 'class CaptureProcessLock' 'run_capture_locked'; do
    grep -Fq "$required" "$fb_producer" || {
      echo "process-level lock implementation is missing: $required" >&2
      return 1
    }
  done
  grep -Fq 'run_capture_locked(' "$feas_producer" || {
    echo "feasibility producer does not use the locked capture entrypoint" >&2
    return 1
  }

  # 2. Each producer's lock identity is a real path assignment, not a mention.
  #    `grep -m1` avoids a SIGPIPE under `pipefail`, and `|| true` keeps a
  #    no-match from aborting the release silently: the explicit diagnostics on
  #    the next lines must be the thing that fires.
  fb_identity="$(grep -m1 -oE '^FEATURE_BUS_CAPTURE_LOCK_PATH[[:space:]]*=[[:space:]]*"[^"]+"' "$fb_producer" 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/' || true)"
  feas_identity="$(grep -m1 -oE '^FEASIBILITY_CAPTURE_LOCK_PATH[[:space:]]*=[[:space:]]*"[^"]+"' "$feas_producer" 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/' || true)"
  [[ -n "$fb_identity" ]] || {
    echo "Feature Bus lock identity path is not defined (FEATURE_BUS_CAPTURE_LOCK_PATH) in $fb_producer" >&2
    return 1
  }
  [[ -n "$feas_identity" ]] || {
    echo "feasibility lock identity path is not defined (FEASIBILITY_CAPTURE_LOCK_PATH) in $feas_producer" >&2
    return 1
  }

  # 3. The two producers' lock identities must be DISTINCT.
  [[ "$fb_identity" != "$feas_identity" ]] || {
    echo "Feature Bus and feasibility producers share a lock identity: $fb_identity" >&2
    return 1
  }
  echo "OPIP_FEATURE_BUS_LOCK_IDENTITY=$fb_identity"
  echo "OPIP_FEASIBILITY_LOCK_IDENTITY=$feas_identity"
  # --- release-scheduler lock verification (end) ----------------------------

  echo "OPIP_RELEASE_SCHEDULER=UNIQUE_BOUNDED"
}

wait_unified_cycle_success() {
  local ready_after="$1" deadline="$2"
  local status completed_at completed_epoch ready_epoch
  ready_epoch="$(date -u -d "$ready_after" +%s)"
  while (( SECONDS < deadline )); do
    status="$(grep -oE 'OPIP_UNIFIED_CYCLE_STATUS=(SUCCESS|DEGRADED)' \
      /var/log/ohm-unified-cycle.log 2>/dev/null | tail -n 1 | cut -d= -f2 || true)"
    completed_at="$(grep -oE 'OPIP_UNIFIED_CYCLE_COMPLETED_AT=[^[:space:]]+' \
      /var/log/ohm-unified-cycle.log 2>/dev/null | tail -n 1 | cut -d= -f2 || true)"
    if [[ -n "$status" && -n "$completed_at" ]]; then
      completed_epoch="$(date -u -d "$completed_at" +%s 2>/dev/null || true)"
      if [[ "$completed_epoch" =~ ^[0-9]+$ ]] && (( completed_epoch >= ready_epoch )); then
        [[ "$status" == "SUCCESS" ]] || {
          echo "unified cycle reported DEGRADED after candidate readiness" >&2
          return 1
        }
        echo "OPIP_UNIFIED_CYCLE=HEALTHY"
        echo "OPIP_UNIFIED_CYCLE_COMPLETED_AT=$completed_at"
        return 0
      fi
    fi
    sleep 5
  done
  echo "no successful unified cycle was observed within the bounded release window" >&2
  return 1
}

validate_candidate_container_identity() {
  local image_sha actual profile expected
  local -a expected_modes
  image_sha="$(docker inspect --format='{{ index .Config.Labels "org.opencontainers.image.revision" }}' ohm-trade-agent)"
  [[ "$image_sha" == "$TARGET_SHA" ]] || {
    echo "candidate container image SHA does not match the approved SHA" >&2
    return 1
  }
  actual="$(docker inspect --format='{{range .Config.Env}}{{println .}}{{end}}' ohm-trade-agent \
    | grep -E '^OPIP_(RELEASE_PROFILE|FEATURE_BUS_MODE|CANONICAL_WRITER_MODE|TARGET_SPINE_MODE|PAPER_V2_MODE|COMMITTEE_MODE)=')"
  profile="$(grep -E '^OPIP_RELEASE_PROFILE=' <<< "$actual" | cut -d= -f2)"
  case "$profile" in
    EVIDENCE_SHADOW)
      expected_modes=(
        'OPIP_FEATURE_BUS_MODE=shadow'
        'OPIP_CANONICAL_WRITER_MODE=shadow'
        'OPIP_TARGET_SPINE_MODE=shadow'
        'OPIP_PAPER_V2_MODE=off'
        'OPIP_COMMITTEE_MODE=off'
      )
      ;;
    *)
      echo "candidate container release profile is not deployable: ${profile:-missing}; SAFE_BASELINE is rollback-only" >&2
      return 1
      ;;
  esac
  grep -Fxq "OPIP_RELEASE_PROFILE=$profile" <<< "$actual" || {
    echo "candidate container release profile is missing or ambiguous" >&2
    return 1
  }
  for expected in "${expected_modes[@]}"; do
    grep -Fxq "$expected" <<< "$actual" || {
      echo "candidate container mode does not match $profile: $expected" >&2
      return 1
    }
  done
  echo "OPIP_RELEASE_PROFILE=$profile"
}

"${GIT[@]}" fetch --prune origin main
REMOTE_MAIN_SHA="$("${GIT[@]}" rev-parse origin/main)"
if [[ "$TARGET_SHA" != "$REMOTE_MAIN_SHA" ]]; then
  echo "refusing deploy: target is not current origin/main" >&2
  echo "target=$TARGET_SHA origin/main=$REMOTE_MAIN_SHA" >&2
  exit 65
fi

if [[ -n "$("${GIT[@]}" status --porcelain --untracked-files=no)" ]]; then
  echo "refusing deploy: tracked production worktree is dirty" >&2
  "${GIT[@]}" status --short >&2
  exit 66
fi
UNTRACKED_APP_FILES="$("${GIT[@]}" ls-files --others --exclude-standard -- OHM-Trade-Agent-v1/app)"
IGNORED_APP_FILES="$("${GIT[@]}" ls-files --others --ignored --exclude-standard -- OHM-Trade-Agent-v1/app \
  | grep -Ev '\.py[cod]$' || true)"
if [[ -n "$UNTRACKED_APP_FILES" || -n "$IGNORED_APP_FILES" ]]; then
  echo "refusing deploy: untracked files in the application Docker build context" >&2
  exit 66
fi

PREVIOUS_SHA="$("${GIT[@]}" rev-parse main)"
if [[ -s "$LAST_GOOD_FILE" ]]; then
  RECORDED_SHA="$(cat "$LAST_GOOD_FILE")"
  if [[ "$RECORDED_SHA" =~ ^[0-9a-f]{40}$ ]] \
    && "${GIT[@]}" cat-file -e "$RECORDED_SHA^{commit}" 2>/dev/null; then
    PREVIOUS_SHA="$RECORDED_SHA"
  fi
fi

cd "$APP_ROOT"
RELEASE_EVIDENCE_BASELINE="$(capture_release_evidence_baseline)"
[[ "$RELEASE_EVIDENCE_BASELINE" == \{*\} ]] || {
  echo "release evidence baseline is malformed; refusing deployment" >&2
  exit 69
}

snapshot_scheduler_state

rollback() {
  rc=$?
  trap - ERR
  # Explicit core-failure marker so the workflow never has to infer core state
  # from an exit code alone.
  echo "OPIP_CORE_DEPLOY_STATUS=FAILED"
  echo "deployment failed; rolling back to $PREVIOUS_SHA" >&2

  # Free paper-worker memory before rebuilding the previous deterministic core.
  stop_paper_stack

  "${GIT[@]}" checkout -f main
  "${GIT[@]}" reset --hard "$PREVIOUS_SHA"
  cd "$APP_ROOT"
  [[ "$("${GIT[@]}" rev-parse HEAD)" == "$PREVIOUS_SHA" ]] || {
    echo "rollback code SHA does not match the selected previous SHA" >&2
    false
  }
  write_safe_baseline_override

  # First PR 2 deploy may roll back to a SHA that does not declare the writer.
  # Detect Compose services after reset; never require a missing service.
  if docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
    config --services 2>/dev/null | grep -qx 'opip-canonical-writer'; then
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      build --build-arg "OPIP_RELEASE_SHA=$PREVIOUS_SHA" \
      opip-canonical-writer ohm-trade-agent
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans opip-canonical-writer
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans ohm-trade-agent
    if ! wait_core_health; then
      echo "rollback core health check failed" >&2
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
    if ! wait_writer_health; then
      echo "rollback writer health check failed" >&2
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
  else
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      build --build-arg "OPIP_RELEASE_SHA=$PREVIOUS_SHA" ohm-trade-agent
    # --remove-orphans drops a writer left from the failed PR 2 attempt.
    docker compose -f docker-compose.yml -f "$SAFE_BASELINE_OVERRIDE" \
      up -d --remove-orphans ohm-trade-agent
    if ! wait_core_health; then
      echo "rollback core health check failed" >&2
      restore_scheduler_state
      cleanup_snapshot
      exit "$rc"
    fi
  fi

  if ! validate_safe_baseline_modes; then
    echo "SAFE_BASELINE rollback mode validation failed" >&2
    restore_scheduler_state
    cleanup_snapshot
    exit "$rc"
  fi

  # Restore the exact scheduler state that was installed before this deploy.
  # This preserves any emergency production containment that is newer than the
  # previous repository revision.
  restore_scheduler_state

  if ! start_paper_stack || ! wait_paper_health; then
    echo "rollback paper topology validation failed" >&2
    cleanup_snapshot
    exit "$rc"
  fi

  printf '%s\n' "$PREVIOUS_SHA" > "$LAST_GOOD_FILE"
  cleanup_snapshot
  echo "OPIP_SAFE_BASELINE_ROLLBACK=SUCCESS"
  echo "rollback health and paper checks passed" >&2
  exit "$rc"
}
trap rollback ERR

# Stop paper workers during the build/recreate window. Their dry-run state is
# bind-mounted and survives the stop, while roughly two worker RSS footprints
# are released during the deployment's highest transient-memory phase.
stop_paper_stack

"${GIT[@]}" checkout -f main
"${GIT[@]}" reset --hard "$TARGET_SHA"

cd "$APP_ROOT"
[[ "$("${GIT[@]}" rev-parse HEAD)" == "$TARGET_SHA" ]] || {
  echo "checked-out repository SHA changed before build" >&2
  false
}
docker compose build --build-arg "OPIP_RELEASE_SHA=$TARGET_SHA" \
  opip-canonical-writer ohm-trade-agent
# Writer and core are independent services. Build/start both; validate each
# separately. Never introduce Compose depends_on: condition=service_healthy
# from ohm-trade-agent onto opip-canonical-writer.
docker compose up -d --remove-orphans opip-canonical-writer
docker compose up -d --remove-orphans ohm-trade-agent

if ! wait_core_health; then
  echo "production core health check failed" >&2
  false
fi
if ! wait_writer_health; then
  echo "production writer health check failed" >&2
  false
fi
if ! validate_writer_resource_limits; then
  echo "production writer resource validation failed" >&2
  false
fi

if [[ ! -s "$SCHEDULER_RECONCILE" ]]; then
  echo "scheduler reconciliation script missing" >&2
  false
fi
bash "$SCHEDULER_RECONCILE"

# Applying the SHA is not complete until the paper topology from that same SHA
# has been recreated and both authoritative dry-run workers are healthy.
start_paper_stack
wait_paper_health
validate_target_resource_budget
validate_candidate_container_identity
validate_release_scheduler_contract

READY_AFTER="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
RELEASE_PROFILE="$(docker compose exec -T ohm-trade-agent \
  python -c 'import os; print(os.environ.get("OPIP_RELEASE_PROFILE", ""))')"
echo "O'Pip bounded $RELEASE_PROFILE runtime verification started at $READY_AFTER"
DEPLOY_VERIFY_DEADLINE=$((SECONDS + 360))
wait_unified_cycle_success "$READY_AFTER" "$DEPLOY_VERIFY_DEADLINE"
REMAINING_VERIFY_SECONDS=$((DEPLOY_VERIFY_DEADLINE - SECONDS))
(( REMAINING_VERIFY_SECONDS > 0 )) || {
  echo "release verifier exhausted its shared 360-second deadline" >&2
  false
}
timeout --signal=TERM --kill-after=5s "$((REMAINING_VERIFY_SECONDS + 10))" \
  docker compose exec -T ohm-trade-agent \
  python -m app.services.release_runtime_verifier \
    --expected-sha "$TARGET_SHA" \
    --baseline-json "$RELEASE_EVIDENCE_BASELINE" \
    --ready-after "$READY_AFTER" \
    --timeout-seconds "$REMAINING_VERIFY_SECONDS"

# All rollback-sensitive validation is complete. Make the exact SHA
# authoritative before the owner-authorized irreversible P1 retirement so a
# cleanup failure can never roll production back to a release that recreates
# the retired outbox.
printf '%s\n' "$TARGET_SHA" > "$LAST_GOOD_FILE"
cleanup_snapshot
trap - ERR

# ---------------------------------------------------------------------------
# CORE RELEASE IS NOW COMMITTED.
#
# Everything below this line is post-deploy work whose failure must never be
# reported as a failed or rolled-back core release. The core release boundary is
# explicit: /var/lib/ohm-deploy/last-good-sha already names the target, the core
# and writer are healthy, the paper topology is validated and the rollback trap
# is disabled.
#
# Post-deploy work is reported through machine-readable markers rather than by
# a single exit code, because two genuinely different things are being measured:
#
#   OPIP_CORE_DEPLOY_STATUS       SUCCESS | FAILED
#   OPIP_PAPER_REGISTRY_GENESIS   INITIALIZED | ALREADY_INITIALIZED | ADOPTED_EXISTING | REFUSED
#   OPIP_P1_RETIREMENT_STATUS     SUCCESS | FAILED | SKIPPED
#   OPIP_LEARNING_EXPORT_STATUS   SUCCESS | FAILED | SKIPPED
#   OPIP_LEARNING_READINESS       READY | BLOCKED
#
# The GitHub workflow consumes these to publish an accurate receipt. A blocked
# learning export on a healthy committed core must never be described as
# "SERVER DEPLOY FAILED" with "Rollback: UNKNOWN OR FAILED".
# ---------------------------------------------------------------------------
echo "OPIP_CORE_DEPLOY_STATUS=SUCCESS"

# --- Paper registry genesis -------------------------------------------------
# `paper_trading/state.json` is both the lifecycle registry and a canonical
# replica completeness companion. A pre-#245 installation that legitimately has
# zero paper lifecycle activity has no registry, and the replica contract
# correctly refuses to certify completeness without it. Genesis supplies the
# missing migration boundary: it creates the canonical EMPTY registry only when
# virgin state is provable, records durable initialization provenance, and
# refuses (identically fail-closed) when evidence exists or state was lost.
#
# A refusal is an integrity incident, not a deploy failure, and the exporter
# below will fail closed on its own if the registry is still absent - so this
# never aborts a committed core release.
genesis_args=(
  --state-file "$DATA_ROOT/paper_trading/state.json"
  --event-file "$DATA_ROOT/paper_trading/events.jsonl"
  --gap-spool "$DATA_ROOT/paper_trading/evidence_gap_spool.json"
  --canonical-db "$DATA_ROOT/opip/canonical/opip_canonical_v1.sqlite3"
  --marker "$PAPER_GENESIS_MARKER"
  --release-sha "$TARGET_SHA"
)
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "OPIP_PAPER_REGISTRY_GENESIS_STATUS=SKIPPED" >&2
  echo "O'Pip Python interpreter missing; paper registry genesis skipped" >&2
elif PYTHONPATH="$APP_ROOT" "$PYTHON_BIN" -m app.services.paper_registry_genesis ensure "${genesis_args[@]}"; then
  # Do not trust the exit code alone. Durable initialization provenance is the
  # artifact that makes a later missing registry distinguishable from virgin
  # state, so OK is reported only when that artifact actually exists and is
  # non-empty. A genesis that created state.json but could not persist the
  # marker must never be reported as proven.
  if [[ -s "$PAPER_GENESIS_MARKER" ]]; then
    echo "OPIP_PAPER_REGISTRY_GENESIS_STATUS=OK"
  else
    echo "OPIP_PAPER_REGISTRY_GENESIS_STATUS=REFUSED" >&2
    echo "O'Pip paper registry genesis reported success but the initialization marker is missing or empty at $PAPER_GENESIS_MARKER; refusing to report durable provenance" >&2
  fi
else
  genesis_rc=$?
  # Read-only reporting: the refusal reason is already on stdout as a marker.
  echo "OPIP_PAPER_REGISTRY_GENESIS_STATUS=REFUSED" >&2
  echo "O'Pip paper registry genesis refused (rc=$genesis_rc); core release unaffected; learning export will fail closed" >&2
fi

# --- P1 shadow outbox retirement (owner-authorized, irreversible) ------------
p1_status="SKIPPED"
if [[ -s "$P1_RETIRE_SCRIPT" ]]; then
  if bash "$P1_RETIRE_SCRIPT"; then
    p1_status="SUCCESS"
  else
    p1_status="FAILED"
    echo "O'Pip P1 shadow outbox retirement FAILED; core release already committed" >&2
  fi
else
  p1_status="FAILED"
  echo "P1 shadow outbox retirement helper missing" >&2
fi
echo "OPIP_P1_RETIREMENT_STATUS=$p1_status"

# --- Learning evidence export (post-deploy gate) -----------------------------
# Publish schema-4 evidence immediately so the remote worker stops requesting the
# retired multi-hundred-MB artifact without waiting for the next cron tick.
#
# Deliberately NOT fatal: this is non-authoritative for the core release. A
# success here also does not prove the target SHA is committed - the exporter
# returns success when a cron run already holds the lock - so the proof below is
# what actually gates learning readiness.
learning_export="SKIPPED"
if [[ -s "$LEARNING_EXPORTER" ]]; then
  if bash "$LEARNING_EXPORTER"; then
    learning_export="SUCCESS"
  else
    learning_export="FAILED"
    echo "O'Pip learning evidence export FAILED; core release already committed" >&2
  fi
else
  learning_export="FAILED"
  echo "learning exporter missing after P1 retirement" >&2
fi
echo "OPIP_LEARNING_EXPORT_STATUS=$learning_export"

# --- Fresh committed-export proof (authoritative learning readiness) --------
# A lock skip is valid exporter behaviour and is NOT proof that the deployed SHA
# is exported. Readiness is therefore proven from durable artifacts: the
# committed manifest must name this exact SHA, be fresh, carry replica marker
# version 1, reference a real content-addressed replica directory, and that
# generation's inner manifest must verify against this same release.
#
# The wait is bounded (derived from the export cadence) and covers exactly one
# legitimate case: the exporter skipped because the cron run held the lock, so
# the next scheduled run may still commit the target. It never spins.
learning_readiness="BLOCKED"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "O'Pip Python interpreter missing; committed-export proof unavailable" >&2
elif PYTHONPATH="$APP_ROOT" "$PYTHON_BIN" -m app.opip.learning.canonical_replica verify-export \
  --root "$EXPORT_ROOT" \
  --release-sha "$TARGET_SHA" \
  --max-age-seconds "$EXPORT_PROOF_FRESHNESS_SECONDS" \
  --wait-seconds "$EXPORT_PROOF_WAIT_SECONDS"; then
  learning_readiness="READY"
fi
echo "OPIP_LEARNING_READINESS=$learning_readiness"

# ---------------------------------------------------------------------------
# POST-COMMIT OBSERVATIONS.
#
# The core release is already committed above. Every command from here on is
# diagnostic, so none of them may abort the script: under `set -e` an unguarded
# nonzero `docker`/`curl` would end the process nonzero, and the workflow would
# then report a committed, healthy core as SERVER DEPLOY FAILED. Each command is
# therefore captured and folded into one structured health marker, and the script
# always exits 0 once the core is committed.
# ---------------------------------------------------------------------------
# Learning computation is remote-only. Production performs only the lightweight
# bounded evidence export installed by reconcile-scheduler.sh.
echo "O'Pip deployment succeeded"
echo "sha=$TARGET_SHA"

postcommit_problems=0
compose_ps_out="$(docker compose ps 2>&1)" || postcommit_problems=1
printf '%s\n' "$compose_ps_out"
paper_ps_out="$(docker compose -f "$PAPER_COMPOSE" ps 2>&1)" || postcommit_problems=1
printf '%s\n' "$paper_ps_out"
if curl --fail --silent --show-error http://127.0.0.1:8000/health; then
  echo
else
  echo "O'Pip post-commit core health probe failed" >&2
  postcommit_problems=1
fi

if (( postcommit_problems == 0 )); then
  echo "OPIP_CORE_POSTCOMMIT_HEALTH=OK"
else
  echo "OPIP_CORE_POSTCOMMIT_HEALTH=DEGRADED"
fi

# The core release is committed, so this process must not report failure on its
# way out. Anything genuinely wrong is carried by the structured markers above.
exit 0
