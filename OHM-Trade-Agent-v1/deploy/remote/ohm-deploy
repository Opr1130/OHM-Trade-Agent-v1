snapshot_scheduler_state

#: Candidate evidence producers that can contend with the canonical writer's
#: store lock. They are installed by the CANDIDATE revision's scheduler
#: reconciliation, they are the only scheduled processes that open canonical
#: storage, and they run inside `ohm-trade-agent` -- which rollback leaves
#: running until the previous core is recreated. They must therefore be BOTH
#: snapshotted (so the previous revision's exact scheduler state is restored)
#: AND quiesced at the start of a rollback (so no producer can start inside the
#: writer-rebuild window and win the store lock from the about-to-restore
#: writer).
EVIDENCE_PRODUCER_CRON_ENTRIES=(
  opip-feature-bus-capture
  opip-feasibility-evidence-capture
)

#: Host-side bound for the whole producer-quiescence exec (schedule removal plus
#: TERM/KILL escalation and the absence re-proof). It only has to cover one
#: bounded `/proc` scan loop, never a slow network or market read.
EVIDENCE_PRODUCER_QUIESCE_SECONDS=60

#: The producer host LAUNCH-LOCK identities: the SAME paths the cron entries pass
#: to `flock -n`. Acquiring them is a REAL synchronization barrier, so:
#:   * a cron wrapper that cron already spawned before the schedule was removed
#:     (but has not yet started its in-container producer) is WAITED FOR, and
#:   * once rollback owns both, no late wrapper can successfully start another
#:     producer, because its own `flock -n` fails immediately.
#: Removing the cron entries alone cannot do either: it is a race, not a barrier.
EVIDENCE_PRODUCER_HOST_LOCKS=(
  /var/run/opip-feature-bus-capture.lock
  /var/run/opip-feasibility-capture.lock
)

#: Finite bound for acquiring both launch locks. One producer invocation is
#: itself bounded (cron runs `timeout ... 50`) and runs at most once a minute, so
#: this covers one in-flight wrapper plus Docker exec startup while remaining a
#: bounded wait, never an open-ended block and never an arbitrary sleep.
EVIDENCE_PRODUCER_LOCK_WAIT_SECONDS=120

#: Fail-closed reason for the most recent quiescence attempt, surfaced as
#: OPIP_EVIDENCE_PRODUCER_QUIESCENCE_REASON.
EVIDENCE_PRODUCER_QUIESCENCE_REASON=""

#: Most recent in-container producer process state: NO_CONTAINER, PROVEN,
#: NOT_QUIESCED or UNKNOWN. NO_CONTAINER is a proven absence (no core container
#: exists, so no producer can be running), never an unknown state.
EVIDENCE_PRODUCER_PROCESS_STATE=""

#: Path/limit overrides are INERT unless explicitly enabled, mirroring the
#: AC-013/AC-014 seam convention: production can never be pointed at a different
#: lock directory or shortened wait by an ambient environment variable.
if [[ "${OPIP_DEPLOY_TEST_SEAMS:-0}" == "1" ]]; then
  if [[ -n "${OPIP_PRODUCER_LOCK_DIR:-}" ]]; then
    EVIDENCE_PRODUCER_HOST_LOCKS=(
      "$OPIP_PRODUCER_LOCK_DIR/opip-feature-bus-capture.lock"
      "$OPIP_PRODUCER_LOCK_DIR/opip-feasibility-capture.lock"
    )
  fi
  if [[ -n "${OPIP_PRODUCER_LOCK_WAIT_SECONDS:-}" ]]; then
    EVIDENCE_PRODUCER_LOCK_WAIT_SECONDS="$OPIP_PRODUCER_LOCK_WAIT_SECONDS"
  fi
fi

#: File descriptors that RETAIN the held launch locks. Ownership must persist
#: across the whole critical section (previous SHA reset, SAFE_BASELINE override,
#: writer rebuild/start, core rebuild/start, health and mode proofs), so the locks
#: are opened on stable descriptors and closed only by
#: release_evidence_producer_locks. Closing them early would reopen the exact
#: window this barrier exists to close.
EVIDENCE_PRODUCER_LOCK_FDS=()

release_evidence_producer_locks() {
  local fd
  for fd in "${EVIDENCE_PRODUCER_LOCK_FDS[@]:-}"; do
    [[ -n "$fd" ]] || continue
    flock -u "$fd" 2>/dev/null || true
    eval "exec $fd>&-" 2>/dev/null || true
  done
  EVIDENCE_PRODUCER_LOCK_FDS=()
  echo "OPIP_EVIDENCE_PRODUCER_LAUNCH_LOCKS=RELEASED"
}

#: Take exclusive ownership of BOTH producer host launch locks with a finite,
#: fail-closed wait. Returns nonzero (and releases anything already taken) when
#: an identity is missing, a lock cannot be opened, or the bounded wait expires.
acquire_evidence_producer_locks() {
  local path fd
  EVIDENCE_PRODUCER_LOCK_FDS=()
  if [[ "${#EVIDENCE_PRODUCER_HOST_LOCKS[@]}" -eq 0 ]]; then
    EVIDENCE_PRODUCER_QUIESCENCE_REASON=LAUNCH_LOCK_IDENTITIES_MISSING
    return 1
  fi
  for path in "${EVIDENCE_PRODUCER_HOST_LOCKS[@]}"; do
    if ! exec {fd}>"$path"; then
      EVIDENCE_PRODUCER_QUIESCENCE_REASON=LAUNCH_LOCK_OPEN_FAILED
      release_evidence_producer_locks
      return 1
    fi
    # `flock -w` is a BOUNDED wait, never an open-ended block: a wrapper that
    # already owns the lock is waited for, and a timeout fails closed rather than
    # proceeding to reset the SHA under a still-live producer.
    if ! flock -x -w "$EVIDENCE_PRODUCER_LOCK_WAIT_SECONDS" "$fd"; then
      eval "exec $fd>&-" 2>/dev/null || true
      EVIDENCE_PRODUCER_QUIESCENCE_REASON=LAUNCH_LOCK_TIMEOUT
      release_evidence_producer_locks
      return 1
    fi
    EVIDENCE_PRODUCER_LOCK_FDS+=("$fd")
  done
  echo "OPIP_EVIDENCE_PRODUCER_LAUNCH_LOCKS=ACQUIRED"
  echo "OPIP_EVIDENCE_PRODUCER_LAUNCH_LOCK_COUNT=${#EVIDENCE_PRODUCER_LOCK_FDS[@]}"
  return 0
}

#: Terminate every candidate evidence producer inside `ohm-trade-agent` and prove
#: that zero remain. Returns nonzero unless the process state was PROVABLE and no
#: survivor remains, so `UNKNOWN`/`NOT_QUIESCED` can never be claimed as safe.
#:
#: `pkill`/`pgrep` are NOT available: the core image is `python:3.12-slim` and
#: ships no `procps`, so a `pkill`-based quiescence step is a silent no-op that
#: would leave a producer owning the store across the writer restore. Process
#: ownership is therefore proven from `/proc` directly with the interpreter that
#: is guaranteed to exist in the image.
#:
#: Canonical ownership is an OS advisory-lock invariant. This function NEVER
#: deletes a lock file; waiting for the owning process to exit is the only sound
#: release mechanism.
producer_process_quiescence() {
  local cid rc=0 out
  EVIDENCE_PRODUCER_PROCESS_STATE=""
  cid="$(docker compose ps -q ohm-trade-agent 2>/dev/null || true)"
  if [[ -z "$cid" ]]; then
    echo "OPIP_EVIDENCE_PRODUCER_PROCESSES_SIGNALLED=0"
    echo "OPIP_EVIDENCE_PRODUCER_PROCESSES_REMAINING=0"
    echo "OPIP_EVIDENCE_PRODUCER_PROCESS_STATE=NO_CONTAINER"
    EVIDENCE_PRODUCER_PROCESS_STATE=NO_CONTAINER
    return 0
  fi

  # The host has coreutils (its own cron entries use `timeout`), so the outer
  # `timeout` bounds the whole exec. The in-container script bounds its own wait
  # too, so a stalled `docker compose exec` client can never hold the rollback.
  # A failed exec is explicitly UNKNOWN and fails closed; the SAFE_BASELINE
  # writer health gate no longer has to be the only proof.
  out="$(timeout --signal=TERM --kill-after=5s "$EVIDENCE_PRODUCER_QUIESCE_SECONDS" \
    docker compose exec -T ohm-trade-agent python - <<'PY'
import os
import signal
import sys
import time

# The scheduled release-scheduler evidence producers. Only these two modules may
# open canonical storage, and each is started as
# `python -m app.jobs.<module>` inside this container.
PATTERNS = (
    "app.jobs.capture_feasibility_evidence_shadow",
    "app.jobs.capture_feature_bus_shadow",
)


def offenders() -> list[int]:
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == os.getpid():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as handle:
                cmdline = handle.read().decode("utf-8", "replace")
        except OSError:
            continue
        if any(pattern in cmdline for pattern in PATTERNS):
            found.append(pid)
    return found


def signal_all(pids, sig) -> None:
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass


