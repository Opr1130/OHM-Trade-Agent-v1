{
  "dry_run": true,
  "dry_run_wallet": 5000,
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 3,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "15m",
  "cancel_open_orders_on_exit": true,
  "initial_state": "running",
  "force_entry_enable": false,
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 3100
    },
    "pair_whitelist": [
      "BTC/USD"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "RemotePairList",
      "mode": "whitelist",
      "processing_mode": "append",
      "pairlist_url": "file:///user_data/bridge/pairlist_usd.json",
      "refresh_period": 10,
      "keep_pairlist_on_failure": true,
      "read_timeout": 5
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  },
  "bot_name": "OHM-Freqtrade-Paper-USD",
  "db_url": "sqlite:////freqtrade/state/tradesv3.ohm_dry_run_usd.sqlite",
  "custom_price_max_distance_ratio": 1
}
